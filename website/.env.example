# ============================================================================
#  Oversight website — environment configuration
#  Copy this file to `.env` and fill it in. `install.sh` can generate it for you.
#  Secrets live here; owner-editable settings (price, blurbs, visible channels)
#  live in data/settings.json and are editable from the /admin page.
# ============================================================================

# --- Core -------------------------------------------------------------------
# Port the Node app listens on (Cloudflare Tunnel points at this).
PORT=3000
# Bind address. 127.0.0.1 is correct when a Cloudflare Tunnel / reverse proxy
# is in front of it (recommended). Use 0.0.0.0 only if exposing directly.
HOST=127.0.0.1
# Public URL of the site (used for OAuth redirects, magic links, Stripe returns).
# With no domain yet you can use the tunnel URL Cloudflare gives you, e.g.
# https://something.trycloudflare.com  — or http://localhost:3000 for local dev.
PUBLIC_URL=http://localhost:3000
# Long random string — signs session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-hex-string
# Comma-separated emails that get admin access to /admin on first login.
ADMIN_EMAILS=trevorzimmerman26@gmail.com

# --- NAS releases source ----------------------------------------------------
# The folder (as seen from THIS Linux box) that contains manifest.json plus the
# verified/ and beta/ installer folders. On Windows this is your
# z:\Projects\Oversight\releases share; here it's wherever you mounted it,
# e.g. /mnt/nas/Oversight/releases  (install.sh sets up the CIFS mount).
NAS_RELEASES_DIR=/mnt/nas/Oversight/releases
# How often to re-sync from the NAS, in hours (also runs once on boot).
SYNC_INTERVAL_HOURS=24

# --- Auth: Google Sign-In ---------------------------------------------------
# From https://console.cloud.google.com  → APIs & Services → Credentials →
# OAuth 2.0 Client ID (type: Web application).
# Authorized redirect URI must be:  <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth: email magic-link (SMTP) ------------------------------------------
# Optional. If left blank, magic-link URLs are printed to the server log
# instead of emailed (fine for testing). For Gmail use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From: address on login + receipt emails.
MAIL_FROM="Oversight <no-reply@localhost>"

# --- Stripe -----------------------------------------------------------------
# You can also set these later from the /admin page. Env values win if present.
# Get them at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from https://dashboard.stripe.com/webhooks
# (endpoint = <PUBLIC_URL>/stripe/webhook, event checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
