<%- include('partials/head') %>
<section class="section narrow">
  <div class="panel">
    <h1>Sign in to <%= settings.productName %></h1>
    <p class="muted">Use Google or an emailed magic link. Your purchase is tied to your email.</p>

    <% if (error) { %><div class="alert alert-err"><%= error %></div><% } %>
    <% if (sent) { %><div class="alert alert-ok">Check your inbox — we sent you a sign-in link. (No email set up yet? The link is also printed in the server log.)</div><% } %>

    <% if (googleEnabled) { %>
      <a class="btn btn-google btn-block" href="/auth/google?next=<%= encodeURIComponent(next || '/download') %>">
        <span>G</span> Continue with Google
      </a>
      <div class="or"><span>or</span></div>
    <% } %>

    <form method="post" action="/auth/email" class="stack">
      <input type="hidden" name="next" value="<%= next %>">
      <label>Email address
        <input type="email" name="email" required placeholder="you@example.com" autocomplete="email">
      </label>
      <button class="btn btn-primary btn-block" type="submit">Email me a sign-in link</button>
    </form>
    <p class="muted center small">By signing in you agree this is a personal license for <%= settings.productName %>.</p>
  </div>
</section>
<%- include('partials/foot') %>
