<%- include('partials/head') %>
<section class="section narrow">
  <h1>Your account</h1>
  <div class="panel">
    <div class="kv"><span class="muted">Email</span><span><%= user.email %></span></div>
    <div class="kv"><span class="muted">License</span>
      <span><%= entitled ? '✅ Active — lifetime' : '❌ Not purchased yet' %></span></div>
    <% if (entitled) { %>
      <a class="btn btn-primary" href="/download">Go to downloads</a>
    <% } else { %>
      <form method="post" action="/buy"><button class="btn btn-primary" type="submit">Buy — <%= priceDisplay %></button></form>
    <% } %>
  </div>

  <h2 class="mt">Purchase history</h2>
  <% if (!purchases.length) { %>
    <p class="muted">No purchases yet.</p>
  <% } else { %>
    <table class="table">
      <thead><tr><th>Date</th><th>Amount</th><th>Status</th><th>Source</th></tr></thead>
      <tbody>
        <% purchases.forEach(function(p){ %>
          <tr>
            <td><%= new Date(p.created_at + 'Z').toLocaleDateString() %></td>
            <td><%= p.amount_cents ? '$' + (p.amount_cents/100).toFixed(2) : '—' %> <%= (p.currency||'').toUpperCase() %></td>
            <td><span class="pill pill-<%= p.status %>"><%= p.status %></span></td>
            <td><%= p.source %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</section>
<%- include('partials/foot') %>
