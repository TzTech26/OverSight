<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Oversight.Linux.Ui"
             x:Class="Oversight.Linux.App"
             Name="Oversight"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Same palette as the Windows app (Themes/Dark.xaml and Light.xaml there). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Os.Window" Color="#202020" />
                    <SolidColorBrush x:Key="Os.Sidebar" Color="#1C1C1C" />
                    <SolidColorBrush x:Key="Os.CardFill" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="Os.CardStroke" Color="#1D1D1D" />
                    <SolidColorBrush x:Key="Os.Line" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="Os.Text" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Os.TextMuted" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="Os.TextFaint" Color="#787878" />
                    <SolidColorBrush x:Key="Os.Accent" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="Os.AccentText" Color="#60CDFF" />
                    <SolidColorBrush x:Key="Os.AccentSoft" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="Os.AccentSoftStrong" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="Os.Hot" Color="#FCE100" />
                    <SolidColorBrush x:Key="Os.HotSoft" Color="#1FFCE100" />
                    <SolidColorBrush x:Key="Os.Danger" Color="#FF99A4" />
                    <SolidColorBrush x:Key="Os.Success" Color="#6CCB5F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Os.Window" Color="#F9F9F9" />
                    <SolidColorBrush x:Key="Os.Sidebar" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="Os.CardFill" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Os.CardStroke" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="Os.Line" Color="#EAEAEA" />
                    <SolidColorBrush x:Key="Os.Text" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="Os.TextMuted" Color="#5F5F5F" />
                    <SolidColorBrush x:Key="Os.TextFaint" Color="#A0A0A0" />
                    <SolidColorBrush x:Key="Os.Accent" Color="#0067C0" />
                    <SolidColorBrush x:Key="Os.AccentText" Color="#005FB8" />
                    <SolidColorBrush x:Key="Os.AccentSoft" Color="#0A000000" />
                    <SolidColorBrush x:Key="Os.AccentSoftStrong" Color="#14000000" />
                    <SolidColorBrush x:Key="Os.Hot" Color="#9D5D00" />
                    <SolidColorBrush x:Key="Os.HotSoft" Color="#1A9D5D00" />
                    <SolidColorBrush x:Key="Os.Danger" Color="#C42B1C" />
                    <SolidColorBrush x:Key="Os.Success" Color="#0F7B0F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The Oversight mark: a scope reticle on a blue tile (same artwork as the Windows LogoMark). -->
            <DrawingImage x:Key="Os.Logo">
                <DrawingGroup>
                    <GeometryDrawing Geometry="M16,0 H48 A16,16 0 0 1 64,16 V48 A16,16 0 0 1 48,64 H16 A16,16 0 0 1 0,48 V16 A16,16 0 0 1 16,0 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#60CDFF" Offset="0" />
                                <GradientStop Color="#0078D4" Offset="0.55" />
                                <GradientStop Color="#005A9E" Offset="1" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M17,32 A15,15 0 1 0 47,32 A15,15 0 1 0 17,32 Z M32,9 V19 M32,45 V55 M9,32 H19 M45,32 H55">
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="4.2" LineCap="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="White" Geometry="M28.5,32 A3.5,3.5 0 1 0 35.5,32 A3.5,3.5 0 1 0 28.5,32 Z" />
                </DrawingGroup>
            </DrawingImage>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#4CC2FF" RegionColor="#202020" />
                <ColorPaletteResources x:Key="Light" Accent="#0067C0" RegionColor="#F9F9F9" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Os.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Os.Text}" />
        </Style>
        <Style Selector="TextBlock.pageSubtitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Os.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Os.Text}" />
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>
        <Style Selector="TextBlock.overline">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Foreground" Value="{DynamicResource Os.TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Os.TextMuted}" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Os.CardFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Os.CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.slot">
            <Setter Property="Padding" Value="16,12,16,14" />
            <Setter Property="Margin" Value="0,18,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource Os.AccentSoftStrong}" />
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Os.Line}" />
        </Style>
        <Style Selector="Border.callout">
            <Setter Property="Background" Value="{DynamicResource Os.AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Os.AccentSoftStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style Selector="Border.unsaved">
            <Setter Property="Background" Value="{DynamicResource Os.HotSoft}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{DynamicResource Os.Danger}" />
        </Style>
        <Style Selector="Slider">
            <Setter Property="Width" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- One row in a settings card: title and description on the left, a control on the right. -->
        <Style Selector="ui|SettingRow">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="16,8" MinHeight="40">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="{TemplateBinding Header}" Foreground="{DynamicResource Os.Text}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Margin="0,2,0,0" Text="{TemplateBinding Description}"
                                       IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
