<Window x:Class="Oversight.UI.ProfileNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oversight"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource DialogWindow}">

    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="TxtPrompt" TextWrapping="Wrap" Margin="0,0,0,12"
                   FontSize="14" Foreground="{DynamicResource TextBrush}"/>
        <TextBox   x:Name="TxtName" KeyDown="TxtName_KeyDown" AutomationProperties.Name="Name"/>
        <TextBlock x:Name="TxtError" Foreground="{DynamicResource DangerTextBrush}" FontSize="12.5"
                   Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Click="Cancel_Click" MinWidth="92" IsCancel="True"
                    Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
            <Button Content="OK" Click="Ok_Click" MinWidth="92"
                    Style="{StaticResource AccentButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
