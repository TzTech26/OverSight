<Window x:Class="Oversight.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Oversight.UI"
        xmlns:ui="clr-namespace:Oversight.UI"
        Title="Oversight"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1060" Height="790" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="13.5"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
        Layout: custom-chrome window → left sidebar (brand + nav) and a scrolling page per
        section. The sidebar IS the TabControl's template, so TabsMain / TabXh / TabAc keep
        working exactly as before for the code-behind (live crosshair preview, etc.).
        Shared control styles live in Themes/Controls.xaml; colours in Themes/Dark|Light.xaml.
    -->

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ════════════════ Caption buttons ════════════════ -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width"      Value="46"/>
            <Setter Property="Height"     Value="40"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsTabStop"  Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFC42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFB0281A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════ Sidebar navigation (TabControl + TabItem) ════════════════ -->
        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="252"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>   <!-- caption / drag strip -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Sidebar -->
                            <Border Grid.Column="0" Grid.RowSpan="2"
                                    Background="{DynamicResource ChromeBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
                                <Grid>
                                    <Border Background="{DynamicResource SidebarGlowBrush}" IsHitTestVisible="False"/>
                                    <DockPanel>
                                        <!-- Brand -->
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,16,0">
                                            <ContentControl ContentTemplate="{StaticResource LogoMark}" Content="{x:Null}"
                                                            Width="40" Height="40" Focusable="False" IsTabStop="False"/>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Oversight" FontFamily="{StaticResource DisplayFont}"
                                                           FontWeight="SemiBold" FontSize="19"
                                                           Foreground="{DynamicResource TitleTextBrush}"/>
                                                <TextBlock Text="Gaming overlay toolkit" FontSize="11.5" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock DockPanel.Dock="Top" Text="SETTINGS" Style="{StaticResource Overline}"
                                                   Margin="26,32,0,8"/>

                                        <!-- Footer -->
                                        <Border DockPanel.Dock="Bottom" Margin="14,0,14,16" Padding="14,11"
                                                CornerRadius="8" Background="{DynamicResource HoverOverlayBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextLabelBrush}"/>
                                                <TextBlock Text="A dot beside a page means it has unsaved changes."
                                                           FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <!-- Page -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" Grid.Row="1"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Margin="12,2" Padding="12,10" CornerRadius="5" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar" Grid.ColumnSpan="3" Width="3" Height="18" CornerRadius="1.5"
                                        HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Hidden"
                                        Background="{DynamicResource AccentBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.9"
                                                          Color="{DynamicResource AccentGlowColor}"/>
                                    </Border.Effect>
                                </Border>
                                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="Ico"
                                              Data="{Binding (ui:UiProps.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.9"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <ContentPresenter x:Name="Txt" Grid.Column="1" ContentSource="Header"
                                                  Margin="13,0,0,0" VerticalAlignment="Center"
                                                  TextElement.FontSize="14"
                                                  TextElement.Foreground="{DynamicResource TextMutedBrush}"/>
                                <Ellipse x:Name="Dirty" Grid.Column="2" Width="8" Height="8" Margin="8,0,0,0"
                                         VerticalAlignment="Center" Visibility="Collapsed"
                                         Fill="{DynamicResource HotBrush}" ToolTip="Unsaved changes"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ui:UiProps.IsDirty" Value="True">
                                <Setter TargetName="Dirty" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd"  Property="Background"             Value="{DynamicResource HoverOverlayBrush}"/>
                                <Setter TargetName="Txt" Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter TargetName="Ico" Property="Stroke"                 Value="{DynamicResource TextLabelBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd"  Property="Background"             Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Bar" Property="Visibility"             Value="Visible"/>
                                <Setter TargetName="Txt" Property="TextElement.Foreground" Value="{DynamicResource TitleTextBrush}"/>
                                <Setter TargetName="Txt" Property="TextElement.FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Ico" Property="Stroke"                 Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════ Page building blocks ════════════════ -->
        <Style x:Key="PageScroller" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Focusable"                   Value="False"/>
            <Setter Property="Padding"                     Value="0,0,6,0"/>
        </Style>

        <Style x:Key="PageBody" TargetType="StackPanel">
            <Setter Property="Margin"   Value="40,4,36,40"/>
            <Setter Property="MaxWidth" Value="920"/>
        </Style>

        <!-- Highlighted card that holds a feature's save-slot picker. -->
        <Style x:Key="SlotCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="20,16,20,18"/>
            <Setter Property="Margin"  Value="0,24,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftStrongBrush}"/>
        </Style>

        <!-- Informational callout -->
        <Style x:Key="Callout" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentSoftStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="Margin"          Value="0,16,0,0"/>
        </Style>

        <Style x:Key="CalloutGlyph" TargetType="TextBlock">
            <Setter Property="Text"              Value="&#xE946;"/>
            <Setter Property="FontFamily"        Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize"          Value="15"/>
            <Setter Property="Foreground"        Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="Margin"            Value="0,1,12,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- Compact row used inside the crosshair style card -->
        <Style x:Key="CompactRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin"    Value="0,6"/>
        </Style>

        <Style x:Key="CompactLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13.5"/>
            <Setter Property="FontWeight"        Value="Medium"/>
            <Setter Property="Foreground"        Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SliderBox" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Width"             Value="220"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Crosshair preview "scene": dark radial backdrop with a faint tactical grid -->
        <DrawingBrush x:Key="PreviewGridBrush" TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#12FFFFFF" Thickness="1"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="22,0"/>
                            <LineGeometry StartPoint="0,0" EndPoint="0,22"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <RadialGradientBrush x:Key="PreviewSceneBrush" RadiusX="0.75" RadiusY="0.75">
            <GradientStop Color="#FF55565C" Offset="0"/>
            <GradientStop Color="#FF303135" Offset="0.6"/>
            <GradientStop Color="#FF18191B" Offset="1"/>
        </RadialGradientBrush>

    </Window.Resources>

    <Border x:Name="RootBorder">
        <!-- WindowChrome windows overhang the screen by the resize border when maximized. -->
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <TabControl x:Name="TabsMain" SelectionChanged="TabsMain_SelectionChanged">

                <!-- ═══════════════════════════════ Zoom ═══════════════════════════════ -->
                <TabItem x:Name="TabZoom" Header="Zoom" ui:UiProps.Icon="{StaticResource IconZoom}">
                    <ScrollViewer Style="{StaticResource PageScroller}">
                        <StackPanel Style="{StaticResource PageBody}">

                            <TextBlock Text="Zoom" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Magnify the screen around your cursor. Everything on this page is stored in a zoom save slot — assign slots to games in Game Profiles, or switch them from the tray icon."/>

                            <!-- Save slot -->
                            <Border Style="{StaticResource SlotCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ZOOM SAVE SLOT" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                                        <Border x:Name="PillZoomUnsaved" Style="{StaticResource UnsavedPill}" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource HotBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Unsaved changes" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HotTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox x:Name="CbProfile" Margin="0,10,0,0" SelectionChanged="CbProfile_Changed"
                                              AutomationProperties.Name="Zoom save slot"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Save" Click="SaveProfile_Click" Style="{StaticResource AccentButton}"
                                                ui:UiProps.Glyph="&#xE74E;" MinWidth="96" Margin="0,0,8,0"/>
                                        <Button Content="Save as…" Click="SaveAsProfile_Click" ui:UiProps.Glyph="&#xE792;" Margin="0,0,8,0"/>
                                        <Button Content="New" Click="NewProfile_Click" Style="{StaticResource GhostButton}"
                                                ui:UiProps.Glyph="&#xE710;" Margin="0,0,4,0"/>
                                        <Button Content="Rename" Click="RenameProfile_Click" Style="{StaticResource GhostButton}"
                                                ui:UiProps.Glyph="&#xE8AC;" Margin="0,0,4,0"/>
                                        <Button x:Name="BtnDeleteProfile" Content="Delete" Click="DeleteProfile_Click"
                                                Style="{StaticResource DangerButton}" ui:UiProps.Glyph="&#xE74D;"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Magnification -->
                            <TextBlock Text="Magnification" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Default zoom level" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="How far the screen magnifies when zoom turns on. 2.0× makes everything twice as big."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="SliderZoom" Style="{StaticResource SliderBox}"
                                                    Minimum="1.25" Maximum="16" TickFrequency="0.25" IsSnapToTickEnabled="True"
                                                    ValueChanged="SliderZoom_Changed" AutomationProperties.Name="Default zoom level"/>
                                            <Border Style="{StaticResource ValuePill}">
                                                <TextBlock x:Name="TxtZoom" Style="{StaticResource ValueText}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Zoom step" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="How much each Zoom in / Zoom out press or mouse-wheel notch changes the magnification."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="SliderStep" Style="{StaticResource SliderBox}"
                                                    Minimum="0.1" Maximum="2.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                    ValueChanged="SliderStep_Changed" AutomationProperties.Name="Zoom step"/>
                                            <Border Style="{StaticResource ValuePill}">
                                                <TextBlock x:Name="TxtStep" Style="{StaticResource ValueText}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Animation & panning -->
                            <TextBlock Text="Animation &amp; panning" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Zoom-in animation" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Ramp smoothly up to your zoom level instead of snapping. The slider sets how long it takes."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="SliderAnim" Style="{StaticResource SliderBox}"
                                                    IsEnabled="{Binding IsChecked, ElementName=ChkZoomIn}"
                                                    Minimum="0" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True"
                                                    ValueChanged="SliderAnim_Changed" AutomationProperties.Name="Zoom-in animation duration"/>
                                            <Border Style="{StaticResource ValuePill}">
                                                <TextBlock x:Name="TxtAnim" Style="{StaticResource ValueText}"/>
                                            </Border>
                                            <CheckBox x:Name="ChkZoomIn" Margin="20,0,0,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Zoom-in animation"
                                                      Checked="ChkZoomIn_Changed" Unchecked="ChkZoomIn_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Zoom-out animation" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Ramp smoothly back to normal size when zoom turns off."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="SliderAnimOut" Style="{StaticResource SliderBox}"
                                                    IsEnabled="{Binding IsChecked, ElementName=ChkZoomOut}"
                                                    Minimum="0" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True"
                                                    ValueChanged="SliderAnimOut_Changed" AutomationProperties.Name="Zoom-out animation duration"/>
                                            <Border Style="{StaticResource ValuePill}">
                                                <TextBlock x:Name="TxtAnimOut" Style="{StaticResource ValueText}"/>
                                            </Border>
                                            <CheckBox x:Name="ChkZoomOut" Margin="20,0,0,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Zoom-out animation"
                                                      Checked="ChkZoomOut_Changed" Unchecked="ChkZoomOut_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Smooth panning" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="The view glides toward the cursor instead of tracking it exactly, softening fast moves and monitor hand-offs. Lower is snappier, higher is floatier."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="SliderPan" Style="{StaticResource SliderBox}"
                                                    IsEnabled="{Binding IsChecked, ElementName=ChkSmoothPan}"
                                                    Minimum="0" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True"
                                                    ValueChanged="SliderPan_Changed" AutomationProperties.Name="Smooth panning amount"/>
                                            <Border Style="{StaticResource ValuePill}">
                                                <TextBlock x:Name="TxtPan" Style="{StaticResource ValueText}"/>
                                            </Border>
                                            <CheckBox x:Name="ChkSmoothPan" Margin="20,0,0,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Smooth panning"
                                                      Checked="ChkSmoothPan_Changed" Unchecked="ChkSmoothPan_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Keybinds -->
                            <TextBlock Text="Keybinds" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtZoomHkNote" Style="{StaticResource RowDesc}" Margin="0,14,0,2"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Zoom activation" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Toggle: press once to turn zoom on and again to turn it off. Hold: zoom stays on only while the key is held."/>
                                        </StackPanel>
                                        <ComboBox x:Name="CbActivation" Grid.Column="1" Width="200" VerticalAlignment="Center"
                                                  DisplayMemberPath="Display" SelectionChanged="CbActivation_Changed"
                                                  AutomationProperties.Name="Zoom activation"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Toggle zoom on / off" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                        <local:HotkeyCaptureBox x:Name="HkToggle" Grid.Column="1"
                                                                AutomationProperties.Name="Toggle zoom keybind"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Zoom in" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}" Text="The mouse wheel also zooms while zoom is on."/>
                                        </StackPanel>
                                        <local:HotkeyCaptureBox x:Name="HkZoomIn" Grid.Column="1"
                                                                AutomationProperties.Name="Zoom in keybind"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Zoom out" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                        <local:HotkeyCaptureBox x:Name="HkZoomOut" Grid.Column="1"
                                                                AutomationProperties.Name="Zoom out keybind"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══════════════════════════════ Crosshair ═══════════════════════════════ -->
                <TabItem x:Name="TabXh" Header="Crosshair" ui:UiProps.Icon="{StaticResource IconCrosshair}">
                    <ScrollViewer Style="{StaticResource PageScroller}">
                        <StackPanel Style="{StaticResource PageBody}">

                            <TextBlock Text="Crosshair" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Draw a custom crosshair over games running in Borderless or Windowed mode. Whether it appears is decided per game in Game Profiles."/>

                            <!-- Save slot -->
                            <Border Style="{StaticResource SlotCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="CROSSHAIR SAVE SLOT" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                                        <Border x:Name="PillXhUnsaved" Style="{StaticResource UnsavedPill}" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource HotBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Unsaved changes" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HotTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox x:Name="CbXhProfile" Margin="0,10,0,0" SelectionChanged="CbXhProfile_Changed"
                                              AutomationProperties.Name="Crosshair save slot"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Save" Click="SaveXh_Click" Style="{StaticResource AccentButton}"
                                                ui:UiProps.Glyph="&#xE74E;" MinWidth="96" Margin="0,0,8,0"/>
                                        <Button Content="Save as…" Click="SaveAsXh_Click" ui:UiProps.Glyph="&#xE792;" Margin="0,0,8,0"/>
                                        <Button Content="New" Click="NewXh_Click" Style="{StaticResource GhostButton}"
                                                ui:UiProps.Glyph="&#xE710;" Margin="0,0,4,0"/>
                                        <Button Content="Rename" Click="RenameXh_Click" Style="{StaticResource GhostButton}"
                                                ui:UiProps.Glyph="&#xE8AC;" Margin="0,0,4,0"/>
                                        <Button x:Name="BtnDeleteXh" Content="Delete" Click="DeleteXh_Click"
                                                Style="{StaticResource DangerButton}" ui:UiProps.Glyph="&#xE74D;"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Style + live preview -->
                            <TextBlock Text="Style" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Card}" Padding="20,10">
                                    <StackPanel>
                                        <!-- Shape -->
                                        <Grid Style="{StaticResource CompactRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Shape" Style="{StaticResource CompactLabel}"/>
                                            <ComboBox x:Name="CbXhShape" Grid.Column="1" VerticalAlignment="Center"
                                                      DisplayMemberPath="Display" SelectionChanged="CbXhShape_Changed"
                                                      AutomationProperties.Name="Crosshair shape"/>
                                        </Grid>

                                        <!-- Colour -->
                                        <Grid Style="{StaticResource CompactRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Colour" Style="{StaticResource CompactLabel}"/>
                                            <ComboBox x:Name="CbXhColor" Grid.Column="1" VerticalAlignment="Center"
                                                      SelectionChanged="CbXhColor_Changed" AutomationProperties.Name="Crosshair colour">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="16" Height="16" CornerRadius="5"
                                                                    Background="{Binding Brush}"
                                                                    BorderBrush="#55000000" BorderThickness="1"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox x:Name="TxtXhHex" Grid.Column="3" MaxLength="7" VerticalAlignment="Center"
                                                     FontFamily="{StaticResource DisplayFont}"
                                                     TextChanged="TxtXhHex_Changed"
                                                     ToolTip="Custom colour as #RRGGBB"
                                                     AutomationProperties.Name="Custom colour hex code"/>
                                        </Grid>

                                        <Border Style="{StaticResource RowDivider}" Margin="0,6"/>

                                        <!-- Size -->
                                        <Grid Style="{StaticResource CompactRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Size" Style="{StaticResource CompactLabel}"/>
                                            <Slider x:Name="SliderXhSize" Grid.Column="1" VerticalAlignment="Center"
                                                    Minimum="8" Maximum="128" TickFrequency="2" IsSnapToTickEnabled="True"
                                                    ValueChanged="SliderXhSize_Changed" AutomationProperties.Name="Crosshair size"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValuePill}">
                                                <TextBlock x:Name="TxtXhSize" Style="{StaticResource ValueText}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Thickness -->
                                        <Grid Style="{StaticResource CompactRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Thickness" Style="{StaticResource CompactLabel}"
                                                       ToolTip="Line width of the crosshair. Also scales the centre dot of the dot shapes."/>
                                            <Slider x:Name="SliderXhThickness" Grid.Column="1" VerticalAlignment="Center"
                                                    Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    ValueChanged="SliderXhThickness_Changed" AutomationProperties.Name="Crosshair thickness"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValuePill}">
                                                <TextBlock x:Name="TxtXhThickness" Style="{StaticResource ValueText}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Gap -->
                                        <Grid Style="{StaticResource CompactRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Gap" Style="{StaticResource CompactLabel}"
                                                       ToolTip="Empty space in the middle of the cross shapes so the exact aim point stays clear. Ignored by the dot and circle shapes."/>
                                            <Slider x:Name="SliderXhGap" Grid.Column="1" VerticalAlignment="Center"
                                                    Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    ValueChanged="SliderXhGap_Changed" AutomationProperties.Name="Crosshair gap"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValuePill}">
                                                <TextBlock x:Name="TxtXhGap" Style="{StaticResource ValueText}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Opacity -->
                                        <Grid Style="{StaticResource CompactRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Opacity" Style="{StaticResource CompactLabel}"/>
                                            <Slider x:Name="SliderXhOpacity" Grid.Column="1" VerticalAlignment="Center"
                                                    Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                    ValueChanged="SliderXhOpacity_Changed" AutomationProperties.Name="Crosshair opacity"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValuePill}">
                                                <TextBlock x:Name="TxtXhOpacity" Style="{StaticResource ValueText}"/>
                                            </Border>
                                        </Grid>

                                        <Border Style="{StaticResource RowDivider}" Margin="0,6"/>

                                        <!-- Extras -->
                                        <Grid Style="{StaticResource CompactRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Centre dot" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Style="{StaticResource RowDesc}" Text="A small dot at the exact aim point of cross and circle shapes."/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkXhCenterDot" Grid.Column="1" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Centre dot"
                                                      Checked="ChkXhCenterDot_Changed" Unchecked="ChkXhCenterDot_Changed"/>
                                        </Grid>
                                        <Grid Style="{StaticResource CompactRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Dark outline" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Keeps the crosshair visible on any background."/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkXhOutline" Grid.Column="1" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Dark outline"
                                                      Checked="ChkXhOutline_Changed" Unchecked="ChkXhOutline_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Live preview -->
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" VerticalAlignment="Top">
                                    <StackPanel Width="224">
                                        <StackPanel Orientation="Horizontal" Margin="2,0,0,12">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="LIVE PREVIEW" Style="{StaticResource Overline}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <Border Width="224" Height="224" CornerRadius="6" ClipToBounds="True"
                                                Background="{StaticResource PreviewSceneBrush}"
                                                BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1">
                                            <Grid>
                                                <Border Background="{StaticResource PreviewGridBrush}" CornerRadius="6"/>
                                                <Image x:Name="ImgXhPreview" Stretch="None"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Style="{StaticResource RowDesc}" Margin="2,12,0,0"
                                                   Text="While this page is open your edits also show live at the centre of the screen."/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Keybinds -->
                            <TextBlock Text="Keybinds" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtXhHkNote" Style="{StaticResource RowDesc}" Margin="0,14,0,2"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Show / hide crosshair" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}" Text="Toggles the overlay in the game you're playing."/>
                                        </StackPanel>
                                        <local:HotkeyCaptureBox x:Name="HkCrosshair" Grid.Column="1"
                                                                AutomationProperties.Name="Show or hide crosshair keybind"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Hide while held (ADS)" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Hides the crosshair only while this key or mouse button is held — bind your aim-down-sights button so the game's own scope takes over. Unbound by default."/>
                                        </StackPanel>
                                        <local:HotkeyCaptureBox x:Name="HkHoldHideCrosshair" Grid.Column="1"
                                                                AllowMouseButtons="True"
                                                                AutomationProperties.Name="Hide crosshair while held keybind"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══════════════════════════════ Auto Clicker ═══════════════════════════════ -->
                <TabItem x:Name="TabAc" Header="Auto Clicker" ui:UiProps.Icon="{StaticResource IconClicker}">
                    <ScrollViewer Style="{StaticResource PageScroller}">
                        <StackPanel Style="{StaticResource PageBody}">

                            <TextBlock Text="Auto Clicker" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Repeat a key or mouse button on demand. It never runs on its own — assign a slot to a game in Game Profiles, then press the start/stop key while that game is focused."/>

                            <!-- Save slot -->
                            <Border Style="{StaticResource SlotCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="AUTO-CLICKER SAVE SLOT" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                                        <Border x:Name="PillAcUnsaved" Style="{StaticResource UnsavedPill}" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource HotBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Unsaved changes" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HotTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox x:Name="CbAcProfile" Margin="0,10,0,0" SelectionChanged="CbAcProfile_Changed"
                                              AutomationProperties.Name="Auto-clicker save slot"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Save" Click="SaveAc_Click" Style="{StaticResource AccentButton}"
                                                ui:UiProps.Glyph="&#xE74E;" MinWidth="96" Margin="0,0,8,0"/>
                                        <Button Content="Save as…" Click="SaveAsAc_Click" ui:UiProps.Glyph="&#xE792;" Margin="0,0,8,0"/>
                                        <Button Content="New" Click="NewAc_Click" Style="{StaticResource GhostButton}"
                                                ui:UiProps.Glyph="&#xE710;" Margin="0,0,4,0"/>
                                        <Button Content="Rename" Click="RenameAc_Click" Style="{StaticResource GhostButton}"
                                                ui:UiProps.Glyph="&#xE8AC;" Margin="0,0,4,0"/>
                                        <Button x:Name="BtnDeleteAc" Content="Delete" Click="DeleteAc_Click"
                                                Style="{StaticResource DangerButton}" ui:UiProps.Glyph="&#xE74D;"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Action -->
                            <TextBlock Text="Action" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Key or button to repeat" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Click the box and press a key or mouse button. Left mouse can't be captured in the box — use Left click instead. Modifiers are ignored."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:HotkeyCaptureBox x:Name="HkAcAction" AllowMouseButtons="True"
                                                                    AutomationProperties.Name="Key or button to repeat"/>
                                            <Button Content="Left click" Click="AcSetLeftClick_Click" Margin="8,0,0,0"
                                                    ToolTip="Set the repeated action to the left mouse button (which can't be captured in the box)."/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Mouse click type" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}" Text="Single or double click per repeat. Only applies to mouse buttons."/>
                                        </StackPanel>
                                        <ComboBox x:Name="CbAcClickType" Grid.Column="1" Width="200" VerticalAlignment="Center"
                                                  DisplayMemberPath="Display" SelectionChanged="CbAcClickType_Changed"
                                                  AutomationProperties.Name="Mouse click type"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Timing -->
                            <TextBlock Text="Timing" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Interval" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Delay between clicks. Lower is faster — the minimum is 10 ms (100 clicks per second)."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="SliderAcInterval" Style="{StaticResource SliderBox}"
                                                    Minimum="10" Maximum="2000" TickFrequency="5" IsSnapToTickEnabled="True"
                                                    ValueChanged="SliderAcInterval_Changed" AutomationProperties.Name="Click interval"/>
                                            <Border Style="{StaticResource ValuePill}" MinWidth="82">
                                                <TextBlock x:Name="TxtAcInterval" Style="{StaticResource ValueText}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Random jitter" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Vary each interval by up to this many milliseconds so the timing isn't perfectly even."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="SliderAcJitter" Style="{StaticResource SliderBox}"
                                                    IsEnabled="{Binding IsChecked, ElementName=ChkAcJitter}"
                                                    Minimum="0" Maximum="500" TickFrequency="5" IsSnapToTickEnabled="True"
                                                    ValueChanged="SliderAcJitter_Changed" AutomationProperties.Name="Random jitter amount"/>
                                            <Border Style="{StaticResource ValuePill}" MinWidth="82">
                                                <TextBlock x:Name="TxtAcJitter" Style="{StaticResource ValueText}"/>
                                            </Border>
                                            <CheckBox x:Name="ChkAcJitter" Margin="20,0,0,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Random jitter"
                                                      Checked="ChkAcJitter_Changed" Unchecked="ChkAcJitter_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Adaptive speed limit" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Recommended. Slows down automatically when the target app can't keep up, so very fast rates don't flood and freeze it."/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAcAdaptive" Grid.Column="1" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Adaptive speed limit"
                                                  Checked="ChkAcAdaptive_Changed" Unchecked="ChkAcAdaptive_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Stop condition -->
                            <TextBlock Text="Stop condition" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Stop after" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Run until you stop it, for a set time, or for a number of clicks."/>
                                        </StackPanel>
                                        <ComboBox x:Name="CbAcRepeat" Grid.Column="1" Width="200" VerticalAlignment="Center"
                                                  DisplayMemberPath="Display" SelectionChanged="CbAcRepeat_Changed"
                                                  AutomationProperties.Name="Stop after"/>
                                    </Grid>
                                    <StackPanel x:Name="RowAcSeconds" Visibility="Collapsed">
                                        <Border Style="{StaticResource RowDivider}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Duration (seconds)" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtAcSeconds" Grid.Column="1" Width="120" MaxLength="6"
                                                     VerticalAlignment="Center" TextChanged="TxtAcSeconds_Changed"
                                                     AutomationProperties.Name="Duration in seconds"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel x:Name="RowAcCount" Visibility="Collapsed">
                                        <Border Style="{StaticResource RowDivider}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Number of clicks" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtAcCount" Grid.Column="1" Width="120" MaxLength="7"
                                                     VerticalAlignment="Center" TextChanged="TxtAcCount_Changed"
                                                     AutomationProperties.Name="Number of clicks"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Position -->
                            <TextBlock Text="Position" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Click at a fixed screen point" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Clicks land at the X, Y position below instead of wherever the cursor is. Mouse buttons only."/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAcFixedPos" Grid.Column="1" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Click at a fixed screen point"
                                                  Checked="ChkAcFixedPos_Changed" Unchecked="ChkAcFixedPos_Changed"/>
                                    </Grid>
                                    <StackPanel x:Name="RowAcFixedPos" Visibility="Collapsed">
                                        <Border Style="{StaticResource RowDivider}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="X" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBox x:Name="TxtAcX" Grid.Column="1" MaxLength="6" VerticalAlignment="Center"
                                                     TextChanged="TxtAcPos_Changed" AutomationProperties.Name="X position"/>
                                            <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="18,0,10,0"/>
                                            <TextBox x:Name="TxtAcY" Grid.Column="3" MaxLength="6" VerticalAlignment="Center"
                                                     TextChanged="TxtAcPos_Changed" AutomationProperties.Name="Y position"/>
                                            <Button x:Name="BtnAcCapturePos" Grid.Column="4" Content="Pick point on screen…"
                                                    Click="AcCapturePos_Click" ui:UiProps.Glyph="&#xE81D;"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                                    ToolTip="Click this, then click the spot on screen you want — right-click to cancel."/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Activation & safety -->
                            <TextBlock Text="Activation &amp; safety" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtAcHkNote" Style="{StaticResource RowDesc}" Margin="0,14,0,2"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Start / stop auto-clicker" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                        <local:HotkeyCaptureBox x:Name="HkAcStartStop" Grid.Column="1"
                                                                AutomationProperties.Name="Start or stop auto-clicker keybind"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Start / stop activation" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Toggle: press once to start and again to stop. Hold: clicks only while the key is held down."/>
                                        </StackPanel>
                                        <ComboBox x:Name="CbAcActivation" Grid.Column="1" Width="200" VerticalAlignment="Center"
                                                  DisplayMemberPath="Display" SelectionChanged="CbAcActivation_Changed"
                                                  AutomationProperties.Name="Start or stop activation"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Safety countdown" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Wait this many seconds (with a tray notice) after you press start, so a runaway clicker is easy to catch."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="TxtAcSafetySeconds" Width="64" MaxLength="3"
                                                     IsEnabled="{Binding IsChecked, ElementName=ChkAcSafety}"
                                                     TextChanged="TxtAcSafetySeconds_Changed"
                                                     AutomationProperties.Name="Safety countdown seconds"/>
                                            <TextBlock Text="sec" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                            <CheckBox x:Name="ChkAcSafety" Margin="20,0,0,0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Safety countdown"
                                                      Checked="ChkAcSafety_Changed" Unchecked="ChkAcSafety_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Callout}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource CalloutGlyph}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Foreground="{DynamicResource TextLabelBrush}"
                                               Text="A run stops when you press the key again, when the game loses focus, and when Oversight quits. Injected input may not register in exclusive-fullscreen games — use Borderless or Windowed mode."/>
                                </DockPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══════════════════════════════ Game Profiles ═══════════════════════════════ -->
                <TabItem x:Name="TabGames" Header="Game Profiles" ui:UiProps.Icon="{StaticResource IconGamepad}">
                    <Grid Margin="40,4,36,32" MaxWidth="920">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Game Profiles" Style="{StaticResource PageTitle}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                                   Text="Choose which zoom, crosshair and auto-clicker slots load automatically while each game is in focus. Changes here apply right away."/>

                        <!-- Everywhere else -->
                        <TextBlock Grid.Row="2" Text="Everywhere else" Style="{StaticResource SectionHeader}"/>
                        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="20,16,20,18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowDesc}" Margin="0,0,0,12"
                                           Text="Used on the desktop and in any app that isn't listed below. Pick (off) to disable a feature outside your games."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ZOOM" Style="{StaticResource Overline}" Margin="2,0,0,6"/>
                                        <ComboBox x:Name="CbDefaultZoom" SelectionChanged="CbDefaultZoom_Changed"
                                                  AutomationProperties.Name="Default zoom slot"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CROSSHAIR" Style="{StaticResource Overline}" Margin="2,0,0,6"/>
                                        <ComboBox x:Name="CbDefaultXh" SelectionChanged="CbDefaultXh_Changed"
                                                  AutomationProperties.Name="Default crosshair slot"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="AUTO CLICKER" Style="{StaticResource Overline}" Margin="2,0,0,6"/>
                                        <ComboBox x:Name="CbDefaultAc" SelectionChanged="CbDefaultAc_Changed"
                                                  AutomationProperties.Name="Default auto-clicker slot"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Per-game -->
                        <DockPanel Grid.Row="4" Margin="0,22,0,10" LastChildFill="False">
                            <TextBlock Text="Per-game profiles" Style="{StaticResource SectionHeader}" Margin="2,0,0,0"
                                       VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Remove" Click="RemoveRule_Click" Style="{StaticResource DangerButton}"
                                        ui:UiProps.Glyph="&#xE74D;" Margin="0,0,8,0"
                                        ToolTip="Remove the selected game"/>
                                <Button Click="AddSteam_Click" IsEnabled="False" Margin="0,0,8,0"
                                        ui:UiProps.Glyph="&#xE7FC;" ToolTip="Coming soon">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Add Steam game…" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                            <TextBlock Text="SOON" FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button Content="Add running app…" Click="AddRunningApp_Click"
                                        Style="{StaticResource AccentButton}" ui:UiProps.Glyph="&#xE710;"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="12,12,12,12">
                            <DockPanel>
                                <!-- Column headers -->
                                <Grid DockPanel.Dock="Top" Margin="14,4,24,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="GAME"         Style="{StaticResource Overline}"/>
                                    <TextBlock Grid.Column="1" Text="ZOOM"         Style="{StaticResource Overline}"/>
                                    <TextBlock Grid.Column="3" Text="CROSSHAIR"    Style="{StaticResource Overline}"/>
                                    <TextBlock Grid.Column="5" Text="AUTO CLICKER" Style="{StaticResource Overline}"/>
                                </Grid>

                                <ListBox x:Name="LbRules" SelectionMode="Single" MinHeight="170"
                                         BorderThickness="0" Padding="0"
                                         HorizontalContentAlignment="Stretch"
                                         ui:UiProps.EmptyText="No games yet. Start a game, then click “Add running app…” to give it its own zoom, crosshair and auto-clicker slots.">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="6" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        BorderBrush="{DynamicResource AccentSoftStrongBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding DisplayName, Converter={StaticResource FirstLetter}}"
                                                               FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="15"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                               FontWeight="Medium" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding ProcessName}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <ComboBox Grid.Column="2" Height="32" VerticalAlignment="Center"
                                                          ItemsSource="{Binding ZoomChoices}"
                                                          SelectedItem="{Binding SelectedZoom, Mode=TwoWay}"
                                                          AutomationProperties.Name="Zoom slot"/>
                                                <ComboBox Grid.Column="4" Height="32" VerticalAlignment="Center"
                                                          ItemsSource="{Binding CrosshairChoices}"
                                                          SelectedItem="{Binding SelectedCrosshair, Mode=TwoWay}"
                                                          AutomationProperties.Name="Crosshair slot"/>
                                                <ComboBox Grid.Column="6" Height="32" VerticalAlignment="Center"
                                                          ItemsSource="{Binding AutoClickerChoices}"
                                                          SelectedItem="{Binding SelectedAutoClicker, Mode=TwoWay}"
                                                          AutomationProperties.Name="Auto-clicker slot"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ═══════════════════════════════ General ═══════════════════════════════ -->
                <TabItem x:Name="TabGeneral" Header="General" ui:UiProps.Icon="{StaticResource IconSliders}">
                    <ScrollViewer Style="{StaticResource PageScroller}">
                        <StackPanel Style="{StaticResource PageBody}">

                            <TextBlock Text="General" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="App-wide settings. These are always active and apply immediately — they aren't part of any save slot."/>

                            <TextBlock Text="App" Style="{StaticResource SectionHeader}" Margin="2,24,0,10"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Open Oversight settings" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Global hotkey that shows or hides this window from anywhere."/>
                                        </StackPanel>
                                        <local:HotkeyCaptureBox x:Name="HkOpenSettings" Grid.Column="1"
                                                                AutomationProperties.Name="Open settings keybind"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Run Oversight when Windows starts" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}"
                                                       Text="Starts quietly in the system tray when you sign in."/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkStartup" Grid.Column="1" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Run Oversight when Windows starts"
                                                  Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Callout}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource CalloutGlyph}" Text="&#xE765;"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Foreground="{DynamicResource TextLabelBrush}"
                                               Text="Each feature's own keybinds live on its page (Zoom, Crosshair, Auto Clicker) and are saved with that slot. Click a key box and press your combination; press Escape to clear it."/>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Updates" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock x:Name="TxtUpdateTitle" Style="{StaticResource RowTitle}"/>
                                            <TextBlock x:Name="TxtUpdateStatus" Style="{StaticResource RowDesc}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button x:Name="BtnUpdateNotes" Grid.Column="1" Content="What&apos;s new" Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,0" VerticalAlignment="Center" Click="UpdateNotes_Click"/>
                                        <Button x:Name="BtnUpdate" Grid.Column="2" Content="Check for updates" MinWidth="120"
                                                VerticalAlignment="Center" Click="Update_Click"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Check for updates automatically" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}" Text="Looks at the project&apos;s GitHub releases about once a day. Nothing else is sent."/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkCheckUpdates" Grid.Column="1" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Check for updates automatically"
                                                  Checked="UpdatePrefs_Changed" Unchecked="UpdatePrefs_Changed"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="Install updates automatically" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Style="{StaticResource RowDesc}" Text="Downloads the new version, checks its published checksum and restarts Oversight in the tray."/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAutoInstall" Grid.Column="1" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Install updates automatically"
                                                  Checked="UpdatePrefs_Changed" Unchecked="UpdatePrefs_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="About" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}" Padding="20,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl ContentTemplate="{StaticResource LogoMark}" Content="{x:Null}"
                                                    Width="56" Height="56" Focusable="False" IsTabStop="False"
                                                    VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Oversight" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                                                   FontSize="18" Foreground="{DynamicResource TitleTextBrush}"/>
                                        <TextBlock x:Name="TxtAboutVersion" FontSize="12.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource AccentTextBrush}"/>
                                        <TextBlock Style="{StaticResource RowDesc}" Margin="0,6,0,0"
                                                   Text="Screen zoom, crosshair overlay and auto clicker for Windows 11. Overlays and zoom work best with games in Borderless or Windowed mode — exclusive fullscreen bypasses the desktop compositor."/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <!-- Caption buttons (custom chrome) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click"
                        ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
                <Button x:Name="BtnMaxRestore" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        Click="MaxRestore_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click"
                        ToolTip="Close" AutomationProperties.Name="Close"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
