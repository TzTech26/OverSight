<Window x:Class="Oversight.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Oversight.UI"
        Title="Oversight Settings"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="720" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Display,Segoe UI Variable,Segoe UI,sans-serif"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
        The colour palette lives in Themes/Dark.xaml and Themes/Light.xaml, merged into
        Application.Resources by ThemeManager and swapped live with the Windows theme.
        Every palette colour below is referenced via DynamicResource so the window
        re-themes instantly when the system toggles light/dark.
    -->

    <Window.Resources>

        <!-- ════════════════ Slider (themed) ════════════════ -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"  Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Knob" Fill="{DynamicResource ThumbKnobFill}" Stroke="{DynamicResource ThumbKnobStroke}" StrokeThickness="1"/>
                            <Ellipse x:Name="Dot"  Width="8" Height="8" Fill="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot"  Property="Width"  Value="10"/>
                                <Setter TargetName="Dot"  Property="Height" Value="10"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot"  Property="Fill"   Value="{DynamicResource AccentTextBrush}"/>
                                <Setter TargetName="Dot"  Property="Width"  Value="7"/>
                                <Setter TargetName="Dot"  Property="Height" Value="7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled portion (left of the thumb) -->
        <Style x:Key="SliderFillButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Empty portion (right of the thumb) — transparent but hit-testable -->
        <Style x:Key="SliderTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="16"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground"           Value="{DynamicResource AccentBrush}"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="MinHeight"            Value="22"/>
            <Setter Property="SnapsToDevicePixels"  Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource TrackBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderFillButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderTrackButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════ CheckBox (themed) ════════════════ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Margin"     Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Path x:Name="Check"
                                      Width="11" Height="9" Stretch="Uniform"
                                      Data="M 0,4 L 3.5,7.5 L 9,0"
                                      Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.6"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box"   Property="Background"  Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box"   Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility"  Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════ ScrollBar (slim, themed) ════════════════ -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" CornerRadius="4" Margin="2" Background="{DynamicResource TrackBrush}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbDragBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"      Value="10"/>
            <Setter Property="MinWidth"   Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollPageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════ TabControl + Tabs ════════════════ -->
        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource TabBarBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Background="Transparent" Margin="8,0,0,0"/>
                            </Border>
                            <Border Background="{DynamicResource BgBrush}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="18,11,18,9">
                            <TextBlock x:Name="Hdr"
                                       Text="{TemplateBinding Header}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd"  Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Hdr" Property="Foreground"  Value="{DynamicResource TitleTextBrush}"/>
                                <Setter TargetName="Hdr" Property="FontWeight"  Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                <Setter TargetName="Hdr" Property="Foreground" Value="{DynamicResource TabHoverTextBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════ Buttons ════════════════ -->
        <Style TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource StrokeStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource ButtonHoverBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AccentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════ Labels / Tooltips / Info badge ════════════════ -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextLabelBrush}"/>
            <Setter Property="Padding"    Value="0,2"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background"      Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource StrokeStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="MaxWidth"        Value="300"/>
        </Style>

        <Style x:Key="InfoBadge" TargetType="Border">
            <Setter Property="Width"             Value="16"/>
            <Setter Property="Height"            Value="16"/>
            <Setter Property="CornerRadius"      Value="8"/>
            <Setter Property="Background"        Value="{DynamicResource ButtonBg}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Margin"            Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor"            Value="Help"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource ButtonHoverBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The small "i" glyph that lives inside an InfoBadge -->
        <Style x:Key="InfoGlyph" TargetType="TextBlock">
            <Setter Property="Text"                Value="i"/>
            <Setter Property="FontFamily"          Value="Segoe UI"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="Foreground"          Value="{DynamicResource InfoGlyphBrush}"/>
            <Setter Property="TextAlignment"       Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="0"/>
            <Setter Property="Margin"              Value="0,-1,0,0"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
        </Style>

        <Style TargetType="local:HotkeyCaptureBox">
            <Setter Property="Background"      Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource StrokeStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="Width"           Value="170"/>
            <Setter Property="TextAlignment"   Value="Center"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background"      Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource StrokeStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="2"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding"    Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource StrokeStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════ ComboBox (themed) ════════════════ -->
        <ControlTemplate x:Key="DarkComboToggle" TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource StrokeStrongBrush}"
                    BorderThickness="1" CornerRadius="5">
                <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource ComboArrowBrush}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd"    Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="Arrow" Property="Fill"        Value="{DynamicResource AccentTextBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding"    Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Margin="3,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource StrokeStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          Template="{StaticResource DarkComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="11,0,30,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{DynamicResource TextBrush}"/>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource StrokeStrongBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,4,0,0"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, ElementName=ToggleButton}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ════════════════ Layout helpers ════════════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="18,14"/>
            <Setter Property="Margin"          Value="0,0,0,14"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,14"/>
        </Style>

        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height"     Value="1"/>
            <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="Margin"     Value="0,12"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground"         Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontWeight"         Value="SemiBold"/>
            <Setter Property="TextAlignment"      Value="Right"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="Margin"             Value="8,0,0,0"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>      <!-- tabs   -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ════════════════ Header ════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/app.ico" Width="30" Height="30"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Oversight" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TitleTextBrush}"/>
                    <TextBlock Text="Zoom &amp; crosshair overlay" FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl x:Name="TabsMain" Grid.Row="1" SelectionChanged="TabsMain_SelectionChanged">

            <!-- ════════════════ Zoom ════════════════ -->
            <TabItem Header="Zoom">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BgBrush}"
                              Padding="0,0,4,0">
                    <StackPanel Margin="20,18,20,8">

                        <!-- ── Save slot (profiles) card ── -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Zoom save slot" Style="{StaticResource CardTitle}" Margin="0,0,0,0"/>
                                    <Border Style="{StaticResource InfoBadge}"
                                            ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <TextBlock TextWrapping="Wrap" MaxWidth="290" Foreground="{DynamicResource TextBrush}"
                                                           Text="A zoom slot stores everything about the magnifier — zoom level, animation, panning and the zoom keybinds. Crosshairs have their own save slots on the Crosshair tab. Assign a zoom slot to each game in Game Profiles, or switch slots from the tray icon."/>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock Style="{StaticResource InfoGlyph}"/>
                                    </Border>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Active slot" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="CbProfile" Grid.Column="1" HorizontalAlignment="Stretch"
                                              SelectionChanged="CbProfile_Changed"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Save"     Click="SaveProfile_Click"   Margin="0,0,8,0"
                                            Style="{StaticResource AccentButton}"/>
                                    <Button Content="Save As…"  Click="SaveAsProfile_Click" Margin="0,0,8,0"/>
                                    <Button Content="New"      Click="NewProfile_Click"    Margin="0,0,8,0"/>
                                    <Button Content="Rename"   Click="RenameProfile_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnDeleteProfile" Content="Delete" Click="DeleteProfile_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Zoom card ── -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Zoom" Style="{StaticResource CardTitle}"/>

                                <!-- Default zoom level -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Label Content="Default zoom level" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource InfoBadge}"
                                                ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="260" Foreground="{DynamicResource TextBrush}"
                                                               Text="The magnification the zoom starts at when you turn it on. 2.0 makes everything look twice as big; higher numbers zoom in further."/>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock Style="{StaticResource InfoGlyph}"/>
                                        </Border>
                                    </StackPanel>
                                    <Slider x:Name="SliderZoom" Grid.Column="1"
                                            Minimum="1.25" Maximum="16" TickFrequency="0.25" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderZoom_Changed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtZoom" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                </Grid>

                                <Border Style="{StaticResource RowDivider}"/>

                                <!-- Zoom step -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Label Content="Zoom step" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource InfoBadge}"
                                                ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="260" Foreground="{DynamicResource TextBrush}"
                                                               Text="How much the magnification changes each time you press Zoom In / Zoom Out or scroll the mouse wheel. Smaller values give finer control."/>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock Style="{StaticResource InfoGlyph}"/>
                                        </Border>
                                    </StackPanel>
                                    <Slider x:Name="SliderStep" Grid.Column="1"
                                            Minimum="0.1" Maximum="2.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderStep_Changed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtStep" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Animation & panning card ── -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Animation &amp; panning" Style="{StaticResource CardTitle}"/>

                                <!-- Zoom-in animation -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkZoomIn" Content="Zoom-in animation" VerticalAlignment="Center"
                                                  Checked="ChkZoomIn_Changed" Unchecked="ChkZoomIn_Changed"/>
                                        <Border Style="{StaticResource InfoBadge}"
                                                ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="260" Foreground="{DynamicResource TextBrush}"
                                                               Text="When on, turning zoom on smoothly ramps from normal size up to your default zoom level. The slider sets how long that takes, in milliseconds."/>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock Style="{StaticResource InfoGlyph}"/>
                                        </Border>
                                    </StackPanel>
                                    <Slider x:Name="SliderAnim" Grid.Column="1"
                                            IsEnabled="{Binding IsChecked, ElementName=ChkZoomIn}"
                                            Minimum="0" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderAnim_Changed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAnim" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                </Grid>

                                <Border Style="{StaticResource RowDivider}"/>

                                <!-- Zoom-out animation -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkZoomOut" Content="Zoom-out animation" VerticalAlignment="Center"
                                                  Checked="ChkZoomOut_Changed" Unchecked="ChkZoomOut_Changed"/>
                                        <Border Style="{StaticResource InfoBadge}"
                                                ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="260" Foreground="{DynamicResource TextBrush}"
                                                               Text="When on, turning zoom off smoothly ramps back down to normal size instead of snapping off. The slider sets how long that takes, in milliseconds."/>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock Style="{StaticResource InfoGlyph}"/>
                                        </Border>
                                    </StackPanel>
                                    <Slider x:Name="SliderAnimOut" Grid.Column="1"
                                            IsEnabled="{Binding IsChecked, ElementName=ChkZoomOut}"
                                            Minimum="0" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderAnimOut_Changed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAnimOut" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                </Grid>

                                <Border Style="{StaticResource RowDivider}"/>

                                <!-- Smooth panning -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkSmoothPan" Content="Smooth panning" VerticalAlignment="Center"
                                                  Checked="ChkSmoothPan_Changed" Unchecked="ChkSmoothPan_Changed"/>
                                        <Border Style="{StaticResource InfoBadge}"
                                                ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="260" Foreground="{DynamicResource TextBrush}"
                                                               Text="When on, the magnified view glides toward the cursor instead of tracking it exactly. This softens fast cursor moves and the hand-off when the cursor crosses to another monitor (no hard snap). The slider sets how quickly it catches up — lower is snappier, higher is floatier."/>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock Style="{StaticResource InfoGlyph}"/>
                                        </Border>
                                    </StackPanel>
                                    <Slider x:Name="SliderPan" Grid.Column="1"
                                            IsEnabled="{Binding IsChecked, ElementName=ChkSmoothPan}"
                                            Minimum="0" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderPan_Changed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPan" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Keybinds (saved with this zoom slot) ── -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Keybinds" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtZoomHkNote" Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <!-- Toggle vs hold for the zoom key -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Label Content="Zoom activation" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource InfoBadge}"
                                                ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="280" Foreground="{DynamicResource TextBrush}">
                                                        <Run FontWeight="SemiBold">Toggle</Run> — press the key once to turn zoom on, and again to turn it off.<LineBreak/>
                                                        <Run FontWeight="SemiBold">Hold</Run> — zoom stays on only while you hold the key down.
                                                    </TextBlock>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock Style="{StaticResource InfoGlyph}"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox x:Name="CbActivation" Grid.Column="1" HorizontalAlignment="Stretch"
                                              DisplayMemberPath="Display" SelectionChanged="CbActivation_Changed"/>
                                </Grid>

                                <Border Style="{StaticResource RowDivider}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Toggle zoom on/off"
                                           VerticalAlignment="Center" Margin="0,5"/>
                                    <local:HotkeyCaptureBox x:Name="HkToggle"  Grid.Row="0" Grid.Column="1" Margin="0,5"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Zoom in"
                                           VerticalAlignment="Center" Margin="0,5"/>
                                    <local:HotkeyCaptureBox x:Name="HkZoomIn"  Grid.Row="1" Grid.Column="1" Margin="0,5"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Zoom out"
                                           VerticalAlignment="Center" Margin="0,5"/>
                                    <local:HotkeyCaptureBox x:Name="HkZoomOut" Grid.Row="2" Grid.Column="1" Margin="0,5"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════ Crosshair ════════════════ -->
            <TabItem x:Name="TabXh" Header="Crosshair">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BgBrush}"
                              Padding="0,0,4,0">
                    <StackPanel Margin="20,18,20,8">

                        <!-- ── Crosshair save slot card ── -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Crosshair save slot" Style="{StaticResource CardTitle}" Margin="0,0,0,0"/>
                                    <Border Style="{StaticResource InfoBadge}"
                                            ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <TextBlock TextWrapping="Wrap" MaxWidth="300" Foreground="{DynamicResource TextBrush}"
                                                           Text="A crosshair slot stores one style (shape, size, colour…) and its show/hide keybind. A set of ready-made styles is included — tweak them or make your own. Whether a crosshair actually appears is decided per game in Game Profiles: pick a slot there (or Off). Games must run in Borderless or Windowed mode for overlays to be visible."/>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock Style="{StaticResource InfoGlyph}"/>
                                    </Border>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Active slot" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="CbXhProfile" Grid.Column="1" HorizontalAlignment="Stretch"
                                              SelectionChanged="CbXhProfile_Changed"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Save"     Click="SaveXh_Click"   Margin="0,0,8,0"
                                            Style="{StaticResource AccentButton}"/>
                                    <Button Content="Save As…"  Click="SaveAsXh_Click" Margin="0,0,8,0"/>
                                    <Button Content="New"      Click="NewXh_Click"    Margin="0,0,8,0"/>
                                    <Button Content="Rename"   Click="RenameXh_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnDeleteXh" Content="Delete" Click="DeleteXh_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Style card: all controls beside the live preview ── -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                    <TextBlock Text="Style" Style="{StaticResource CardTitle}"/>

                                    <!-- Shape -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Shape" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CbXhShape" Grid.Column="1" HorizontalAlignment="Stretch"
                                                  DisplayMemberPath="Display" SelectionChanged="CbXhShape_Changed"/>
                                    </Grid>

                                    <!-- Colour -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="86"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Colour" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CbXhColor" Grid.Column="1" HorizontalAlignment="Stretch"
                                                  SelectionChanged="CbXhColor_Changed">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="14" Height="14" CornerRadius="3"
                                                                Background="{Binding Brush}"
                                                                BorderBrush="#66000000" BorderThickness="1"
                                                                VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox x:Name="TxtXhHex" Grid.Column="3" MaxLength="7"
                                                 TextChanged="TxtXhHex_Changed"
                                                 ToolTip="Custom colour as #RRGGBB"/>
                                    </Grid>

                                    <Border Style="{StaticResource RowDivider}"/>

                                    <!-- Size -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Size" Grid.Column="0" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderXhSize" Grid.Column="1"
                                                Minimum="8" Maximum="128" TickFrequency="2" IsSnapToTickEnabled="True"
                                                ValueChanged="SliderXhSize_Changed" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtXhSize" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                    </Grid>

                                    <!-- Thickness -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Thickness" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="Line width of the crosshair. Also scales the centre dot of the dot shapes."/>
                                        <Slider x:Name="SliderXhThickness" Grid.Column="1"
                                                Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="SliderXhThickness_Changed" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtXhThickness" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                    </Grid>

                                    <!-- Gap -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Gap" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="Empty space in the middle of the cross shapes, so the exact aim point stays unobstructed. Ignored by the dot and circle shapes."/>
                                        <Slider x:Name="SliderXhGap" Grid.Column="1"
                                                Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="SliderXhGap_Changed" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtXhGap" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                    </Grid>

                                    <!-- Opacity -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Opacity" Grid.Column="0" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderXhOpacity" Grid.Column="1"
                                                Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                ValueChanged="SliderXhOpacity_Changed" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtXhOpacity" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                    </Grid>

                                    <Border Style="{StaticResource RowDivider}"/>

                                    <!-- Extras -->
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="ChkXhCenterDot"
                                                  Content="Centre dot"
                                                  ToolTip="Adds a small dot at the exact aim point of the cross and circle shapes."
                                                  Checked="ChkXhCenterDot_Changed" Unchecked="ChkXhCenterDot_Changed"/>
                                        <CheckBox x:Name="ChkXhOutline" Margin="24,5,0,5"
                                                  Content="Dark outline"
                                                  ToolTip="Keeps the crosshair visible on any background."
                                                  Checked="ChkXhOutline_Changed" Unchecked="ChkXhOutline_Changed"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Live preview -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,27,0,0">
                                    <Border Width="150" Height="150" CornerRadius="6" ClipToBounds="True"
                                            Background="#FF3A3D41"
                                            BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1">
                                        <Image x:Name="ImgXhPreview" Stretch="None"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Preview" FontSize="11" Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                   Margin="2,0,0,8" TextWrapping="Wrap"
                                   Text="While you're on this tab, your edits show live at the centre of the screen. Assign this slot to games in the Game Profiles tab."/>

                        <!-- ── Keybinds (saved with this crosshair slot) ── -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Keybinds" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtXhHkNote" Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Show / hide crosshair"
                                           VerticalAlignment="Center" Margin="0,5"/>
                                    <local:HotkeyCaptureBox x:Name="HkCrosshair" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Label Content="Hide while held (ADS)" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource InfoBadge}"
                                                ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="280" Foreground="{DynamicResource TextBrush}"
                                                               Text="Hides the crosshair only while this key or mouse button is physically held down — bind your aim-down-sights button (right mouse, or a side button like Mouse 4/5) so the game's own scope takes over. Releasing brings the crosshair back, unless it's already hidden by the Show/hide crosshair key above. Unbound by default."/>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock Style="{StaticResource InfoGlyph}"/>
                                        </Border>
                                    </StackPanel>
                                    <local:HotkeyCaptureBox x:Name="HkHoldHideCrosshair" Grid.Row="1" Grid.Column="1" Margin="0,5"
                                                            AllowMouseButtons="True"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════ Auto Clicker ════════════════ -->
            <TabItem x:Name="TabAc" Header="Auto Clicker">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BgBrush}"
                              Padding="0,0,4,0">
                    <StackPanel Margin="20,18,20,8">

                        <!-- ── Auto-clicker save slot card ── -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Auto-clicker save slot" Style="{StaticResource CardTitle}" Margin="0,0,0,0"/>
                                    <Border Style="{StaticResource InfoBadge}"
                                            ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <TextBlock TextWrapping="Wrap" MaxWidth="300" Foreground="{DynamicResource TextBrush}"
                                                           Text="An auto-clicker slot stores what to press, how fast, and when to stop — plus its start/stop keybind. It never runs on its own: assign a slot to a game in Game Profiles, then press the start/stop key while that game is focused. It stops when you press the key again (or release it in Hold mode), and whenever the game loses focus."/>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock Style="{StaticResource InfoGlyph}"/>
                                    </Border>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Active slot" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="CbAcProfile" Grid.Column="1" HorizontalAlignment="Stretch"
                                              SelectionChanged="CbAcProfile_Changed"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Save"     Click="SaveAc_Click"   Margin="0,0,8,0"
                                            Style="{StaticResource AccentButton}"/>
                                    <Button Content="Save As…"  Click="SaveAsAc_Click" Margin="0,0,8,0"/>
                                    <Button Content="New"      Click="NewAc_Click"    Margin="0,0,8,0"/>
                                    <Button Content="Rename"   Click="RenameAc_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnDeleteAc" Content="Delete" Click="DeleteAc_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Action & timing card ── -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Action &amp; timing" Style="{StaticResource CardTitle}"/>

                                <!-- Key / button to repeat -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Label Content="Key / button to repeat" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource InfoBadge}"
                                                ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="280" Foreground="{DynamicResource TextBrush}"
                                                               Text="Click the box and press the key or mouse button you want repeated — right mouse, a letter, Space, etc. Left mouse can't be captured in the box (that click operates the box), so use the “Left click” button. Any modifiers are ignored; only the key itself is sent."/>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock Style="{StaticResource InfoGlyph}"/>
                                        </Border>
                                    </StackPanel>
                                    <local:HotkeyCaptureBox x:Name="HkAcAction" Grid.Column="1" Margin="0,5"
                                                            AllowMouseButtons="True"/>
                                    <Button Grid.Column="2" Content="Left click" Click="AcSetLeftClick_Click"
                                            Margin="8,5,0,5"
                                            ToolTip="Set the repeated action to the left mouse button (which can't be captured in the box)."/>
                                </Grid>

                                <!-- Mouse click type -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="Mouse click type" VerticalAlignment="Center"
                                           ToolTip="Single or double click per repeat. Only applies when the repeated action is a mouse button."/>
                                    <ComboBox x:Name="CbAcClickType" Grid.Column="1" HorizontalAlignment="Stretch"
                                              DisplayMemberPath="Display" SelectionChanged="CbAcClickType_Changed"/>
                                </Grid>

                                <Border Style="{StaticResource RowDivider}"/>

                                <!-- Interval -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="Interval" VerticalAlignment="Center"
                                           ToolTip="Delay between clicks. Lower = faster, capped at 10 ms (100 clicks/second) to stay stable."/>
                                    <Slider x:Name="SliderAcInterval" Grid.Column="1"
                                            Minimum="10" Maximum="2000" TickFrequency="5" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderAcInterval_Changed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAcInterval" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                </Grid>

                                <!-- Jitter -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkAcJitter" Content="Random jitter ±"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Randomises each interval by up to this many milliseconds so the timing isn't perfectly even."
                                                  Checked="ChkAcJitter_Changed" Unchecked="ChkAcJitter_Changed"/>
                                    </StackPanel>
                                    <Slider x:Name="SliderAcJitter" Grid.Column="1"
                                            Minimum="0" Maximum="500" TickFrequency="5" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderAcJitter_Changed" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAcJitter" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                </Grid>

                                <Border Style="{StaticResource RowDivider}"/>

                                <!-- Adaptive speed limit -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkAcAdaptive" VerticalAlignment="Center"
                                              Content="Adaptive speed limit (keeps very fast rates from freezing the app)"
                                              Checked="ChkAcAdaptive_Changed" Unchecked="ChkAcAdaptive_Changed"/>
                                    <Border Style="{StaticResource InfoBadge}"
                                            ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <TextBlock TextWrapping="Wrap" MaxWidth="300" Foreground="{DynamicResource TextBrush}"
                                                           Text="Recommended. Watches whether the target program is keeping up and automatically slows down when it can't, so extreme click rates (e.g. 1 ms) don't flood and freeze it. Turn off only for raw, uncapped speed — some apps (especially browsers) still can't handle hundreds of clicks a second, so lower the interval if one struggles."/>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock Style="{StaticResource InfoGlyph}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Repeat & stop card ── -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Repeat" Style="{StaticResource CardTitle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="Stop after" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CbAcRepeat" Grid.Column="1" HorizontalAlignment="Stretch"
                                              DisplayMemberPath="Display" SelectionChanged="CbAcRepeat_Changed"/>
                                </Grid>

                                <!-- Duration (For duration) -->
                                <Grid x:Name="RowAcSeconds" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="Duration (seconds)" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtAcSeconds" Grid.Column="1" MaxLength="6"
                                             TextChanged="TxtAcSeconds_Changed"/>
                                </Grid>

                                <!-- Count (For count) -->
                                <Grid x:Name="RowAcCount" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="Number of clicks" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtAcCount" Grid.Column="1" MaxLength="7"
                                             TextChanged="TxtAcCount_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Position, activation & safety card ── -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Position, activation &amp; safety" Style="{StaticResource CardTitle}"/>

                                <!-- Fixed position -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkAcFixedPos" Content="Click at a fixed screen point"
                                              VerticalAlignment="Center"
                                              ToolTip="When on, clicks land at the X,Y below instead of wherever the cursor is. Only affects mouse-button actions."
                                              Checked="ChkAcFixedPos_Changed" Unchecked="ChkAcFixedPos_Changed"/>
                                </StackPanel>
                                <Grid x:Name="RowAcFixedPos" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="X" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtAcX" Grid.Column="1" MaxLength="6" TextChanged="TxtAcPos_Changed"/>
                                    <Label Grid.Column="2" Content="Y" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                    <TextBox x:Name="TxtAcY" Grid.Column="3" MaxLength="6" TextChanged="TxtAcPos_Changed"/>
                                    <Button x:Name="BtnAcCapturePos" Grid.Column="4" Content="Pick point on screen…"
                                            Click="AcCapturePos_Click"
                                            ToolTip="Click this, then click the spot on screen you want — right-click to cancel."
                                            HorizontalAlignment="Left" Margin="16,0,0,0"/>
                                </Grid>

                                <Border Style="{StaticResource RowDivider}"/>

                                <!-- Activation (toggle vs hold) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Label Content="Start/stop activation" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource InfoBadge}"
                                                ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="280" Foreground="{DynamicResource TextBrush}">
                                                        <Run FontWeight="SemiBold">Toggle</Run> — press the start/stop key once to begin, again to stop.<LineBreak/>
                                                        <Run FontWeight="SemiBold">Hold</Run> — clicks only while you hold the start/stop key down.
                                                    </TextBlock>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock Style="{StaticResource InfoGlyph}"/>
                                        </Border>
                                    </StackPanel>
                                    <ComboBox x:Name="CbAcActivation" Grid.Column="1" HorizontalAlignment="Stretch"
                                              DisplayMemberPath="Display" SelectionChanged="CbAcActivation_Changed"/>
                                </Grid>

                                <!-- Safety countdown -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkAcSafety" Grid.Column="0" VerticalAlignment="Center"
                                              Content="Safety countdown before first click (seconds)"
                                              ToolTip="Waits this many seconds (with a tray notice) after you press start, so a runaway clicker is easy to catch."
                                              Checked="ChkAcSafety_Changed" Unchecked="ChkAcSafety_Changed"/>
                                    <TextBox x:Name="TxtAcSafetySeconds" Grid.Column="1" MaxLength="3"
                                             TextChanged="TxtAcSafetySeconds_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Start / stop keybind (saved with this slot) ── -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Keybind" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtAcHkNote" Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="Start / stop auto-clicker"
                                           VerticalAlignment="Center" Margin="0,5"/>
                                    <local:HotkeyCaptureBox x:Name="HkAcStartStop" Grid.Column="1" Margin="0,5"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                   Margin="2,0,0,8" TextWrapping="Wrap"
                                   Text="Assign this slot to games in the Game Profiles tab. Injected input may not register in exclusive-fullscreen games — use Borderless / Windowed mode."/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════ Game Profiles ════════════════ -->
            <TabItem Header="Game Profiles">
                <DockPanel Margin="20,18">

                    <!-- ── Default (no listed game running) card ── -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Everywhere else" Style="{StaticResource CardTitle}" Margin="0,0,0,0"/>
                                <Border Style="{StaticResource InfoBadge}"
                                        ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000">
                                    <Border.ToolTip>
                                        <ToolTip>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="290" Foreground="{DynamicResource TextBrush}"
                                                       Text="What Oversight uses on the desktop / in any app that isn't listed below. Zoom and the crosshair are chosen independently — pick Off to disable one (or both) outside your games. These rules are app-wide — they are not part of any save slot."/>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <TextBlock Style="{StaticResource InfoGlyph}"/>
                                </Border>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="Zoom" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CbDefaultZoom" HorizontalAlignment="Stretch"
                                              SelectionChanged="CbDefaultZoom_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Crosshair" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CbDefaultXh" HorizontalAlignment="Stretch"
                                              SelectionChanged="CbDefaultXh_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <Label Content="Auto clicker" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CbDefaultAc" HorizontalAlignment="Stretch"
                                              SelectionChanged="CbDefaultAc_Changed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Per-game rules card ── -->
                    <Border Style="{StaticResource Card}" Margin="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Per-game profiles" Style="{StaticResource CardTitle}"/>

                            <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                       Margin="0,0,0,12" TextWrapping="Wrap">
                                Add a game, then pick the zoom slot and crosshair slot to use while it's in focus.
                                Either can be "(off)". Changes here apply right away.
                            </TextBlock>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Add running app…" Click="AddRunningApp_Click" Margin="0,0,8,0"/>
                                <Button Content="Add Steam game…"  Click="AddSteam_Click" IsEnabled="False" Margin="0,0,8,0"
                                        ToolTip="Coming soon"/>
                                <Button Content="Remove"           Click="RemoveRule_Click"/>
                            </StackPanel>

                            <!-- Column headers -->
                            <Grid DockPanel.Dock="Top" Margin="9,0,9,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Game" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="Zoom" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="3" Text="Crosshair" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="5" Text="Auto clicker" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>

                            <ListBox x:Name="LbRules" SelectionMode="Single" MinHeight="150"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProcessName}" FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                                      ItemsSource="{Binding ZoomChoices}"
                                                      SelectedItem="{Binding SelectedZoom, Mode=TwoWay}"/>
                                            <ComboBox Grid.Column="3" VerticalAlignment="Center"
                                                      ItemsSource="{Binding CrosshairChoices}"
                                                      SelectedItem="{Binding SelectedCrosshair, Mode=TwoWay}"/>
                                            <ComboBox Grid.Column="5" VerticalAlignment="Center"
                                                      ItemsSource="{Binding AutoClickerChoices}"
                                                      SelectedItem="{Binding SelectedAutoClicker, Mode=TwoWay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ════════════════ General ════════════════ -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BgBrush}"
                              Padding="0,0,4,0">
                    <StackPanel Margin="20,18,20,8">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="General" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                           Margin="0,0,0,12" TextWrapping="Wrap"
                                           Text="App-wide settings — always active and applied immediately (not tied to any save slot)."/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="Open Oversight settings (hotkey)"
                                           VerticalAlignment="Center" Margin="0,5"/>
                                    <local:HotkeyCaptureBox x:Name="HkOpenSettings" Grid.Column="1" Margin="0,5"/>
                                </Grid>

                                <Border Style="{StaticResource RowDivider}"/>

                                <CheckBox x:Name="ChkStartup"
                                          Content="Run Oversight when Windows starts"
                                          Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                   Margin="2,0,0,8" TextWrapping="Wrap"
                                   Text="Each feature's own keybinds live on its tab (Zoom, Crosshair, Auto Clicker) and are saved with that slot. Click a key box and press your combination; press Escape to clear it."/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ════════════════ Footer action bar ════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock Text="Zoom, crosshair and auto-clicker slots save separately — use Save on each tab to store changes."
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Click="Close_Click" Width="88"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
