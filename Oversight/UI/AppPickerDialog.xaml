<Window x:Class="Oversight.UI.AppPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Oversight.UI"
        Title="Add running app"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="480" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource DialogWindow}">

    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock x:Name="TxtHeading" Text="Pick a game" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                       FontSize="20" Foreground="{DynamicResource TitleTextBrush}"/>
            <TextBlock x:Name="TxtHint" Style="{StaticResource RowDesc}"
                       Text="Hold Ctrl or Shift to select several."/>
            <TextBox x:Name="TxtSearch" Margin="0,12,0,0" TextChanged="TxtSearch_TextChanged"
                     ui:UiProps.EmptyText="Search" AutomationProperties.Name="Search"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button x:Name="BtnRefresh" Content="Refresh" Click="Refresh_Click" Style="{StaticResource GhostButton}"
                    ui:UiProps.Glyph="&#xE72C;"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" MinWidth="92" IsCancel="True"
                        Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                <Button x:Name="BtnAdd" Content="Add" Click="Add_Click" MinWidth="92" IsDefault="True"
                        Style="{StaticResource AccentButton}" ui:UiProps.Glyph="&#xE710;"/>
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="LbApps" SelectionMode="Extended" Background="{DynamicResource SurfaceBrush}"
                 MouseDoubleClick="LbApps_MouseDoubleClick"
                 AutomationProperties.Name="Apps">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="6" VerticalAlignment="Center"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentSoftStrongBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="Letter" Visibility="Collapsed"
                                           Text="{Binding DisplayName, Converter={StaticResource FirstLetter}}"
                                           FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                                <Image Source="{Binding Icon}" Width="22" Height="22"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="Medium"/>
                            <TextBlock Text="{Binding Detail}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                            <Setter TargetName="Letter" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
