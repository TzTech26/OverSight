<Window x:Class="Oversight.UI.RunningAppsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Oversight.UI"
        Title="Add running app"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="480" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource DialogWindow}">

    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Pick a game" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                       FontSize="20" Foreground="{DynamicResource TitleTextBrush}"/>
            <TextBlock Style="{StaticResource RowDesc}"
                       Text="Hold Ctrl or Shift to select several."/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource GhostButton}"
                    ui:UiProps.Glyph="&#xE72C;"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" MinWidth="92" IsCancel="True"
                        Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                <Button x:Name="BtnAdd" Content="Add" Click="Add_Click" MinWidth="92"
                        Style="{StaticResource AccentButton}" ui:UiProps.Glyph="&#xE710;"/>
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="LbApps" SelectionMode="Extended" Background="{DynamicResource SurfaceBrush}"
                 MouseDoubleClick="LbApps_MouseDoubleClick"
                 AutomationProperties.Name="Running apps"
                 ui:UiProps.EmptyText="No apps with an open window were found. Start your game, then click Refresh.">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="6" VerticalAlignment="Center"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentSoftStrongBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource FirstLetter}}"
                                       FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="Medium"/>
                            <TextBlock Text="{Binding ProcessName}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
