<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════ Light palette ════════════════ -->
    <!-- Keys here MUST match Dark.xaml one-for-one. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgBrush"          Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="ChromeBrush"      Color="#FFEAEAEA"/>
    <SolidColorBrush x:Key="TabBarBrush"      Color="#FFECECEC"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#FFFBFBFB"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"  Color="#FFFFFFFF"/>

    <!-- Strokes / dividers -->
    <SolidColorBrush x:Key="StrokeBrush"           Color="#FFE2E2E2"/>
    <SolidColorBrush x:Key="DividerBrush"          Color="#FFE6E6E6"/>
    <SolidColorBrush x:Key="StrokeStrongBrush"     Color="#FFCBCBCB"/>
    <SolidColorBrush x:Key="ControlBorderBrush"    Color="#FFB6B6B6"/>
    <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#FFA6A6A6"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush"       Color="#FF0078D4"/>
    <SolidColorBrush x:Key="AccentHoverBrush"  Color="#FF1A86D9"/>
    <SolidColorBrush x:Key="AccentTextBrush"   Color="#FF0A66B5"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#FF0067B8"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"       Color="#FF1B1B1B"/>
    <SolidColorBrush x:Key="TextMutedBrush"  Color="#FF6A6A6A"/>
    <SolidColorBrush x:Key="TextLabelBrush"  Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="TitleTextBrush"  Color="#FF0E0E0E"/>
    <SolidColorBrush x:Key="OnAccentBrush"   Color="#FFFFFFFF"/>

    <!-- Sliders / scrollbars -->
    <SolidColorBrush x:Key="TrackBrush"            Color="#FFD2D2D2"/>
    <SolidColorBrush x:Key="ThumbKnobFill"         Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ThumbKnobStroke"       Color="#FFB0B0B0"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FFB0B0B0"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush"  Color="#FF9A9A9A"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonBg"        Color="#FFFDFDFD"/>
    <SolidColorBrush x:Key="ButtonHoverBg"   Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="ButtonPressedBg" Color="#FFE6E6E6"/>

    <!-- Misc -->
    <SolidColorBrush x:Key="SelectionBrush"    Color="#FF2A82DA"/>
    <SolidColorBrush x:Key="RowHoverBrush"     Color="#FFECECEC"/>
    <SolidColorBrush x:Key="ComboArrowBrush"   Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="TabHoverTextBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="InfoGlyphBrush"    Color="#FF555555"/>

</ResourceDictionary>
