<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════ Light palette — Windows 11 native ════════════════ -->
    <!-- Keys here MUST match Dark.xaml one-for-one. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="ChromeBrush"      Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="BgBrush"          Color="#FFF9F9F9"/>
    <SolidColorBrush x:Key="TabBarBrush"      Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="RaisedBrush"      Color="#FFF9F9F9"/>
    <SolidColorBrush x:Key="KeycapEdgeBrush"  Color="#FFD1D1D1"/>

    <!-- Strokes / dividers -->
    <SolidColorBrush x:Key="StrokeBrush"           Color="#FFE5E5E5"/>
    <SolidColorBrush x:Key="DividerBrush"          Color="#FFEAEAEA"/>
    <SolidColorBrush x:Key="StrokeStrongBrush"     Color="#FFD1D1D1"/>
    <SolidColorBrush x:Key="ControlBorderBrush"    Color="#FF868686"/>
    <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#FFA0A0A0"/>

    <!-- Accent (Windows blue) -->
    <SolidColorBrush x:Key="AccentBrush"           Color="#FF0067C0"/>
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="#FF1975C5"/>
    <SolidColorBrush x:Key="AccentTextBrush"       Color="#FF005FB8"/>
    <SolidColorBrush x:Key="AccentBorderBrush"     Color="#FF005A9E"/>
    <SolidColorBrush x:Key="AccentSoftBrush"       Color="#0A000000"/>
    <SolidColorBrush x:Key="AccentSoftStrongBrush" Color="#14000000"/>
    <Color x:Key="AccentGlowColor">#000067C0</Color>
    <SolidColorBrush x:Key="AccentGradientBrush"      Color="#FF0067C0"/>
    <SolidColorBrush x:Key="AccentGradientHoverBrush" Color="#FF1975C5"/>
    <SolidColorBrush x:Key="SidebarGlowBrush"         Color="Transparent"/>

    <!-- Status -->
    <SolidColorBrush x:Key="HotBrush"        Color="#FF9D5D00"/>
    <SolidColorBrush x:Key="HotSoftBrush"    Color="#1A9D5D00"/>
    <SolidColorBrush x:Key="HotTextBrush"    Color="#FF9D5D00"/>
    <SolidColorBrush x:Key="DangerBrush"     Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#14C42B1C"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="SuccessBrush"    Color="#FF0F7B0F"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"       Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="TextMutedBrush"  Color="#FF5F5F5F"/>
    <SolidColorBrush x:Key="TextLabelBrush"  Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="TextFaintBrush"  Color="#FFA0A0A0"/>
    <SolidColorBrush x:Key="TitleTextBrush"  Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="OnAccentBrush"   Color="#FFFFFFFF"/>

    <!-- Sliders / toggles / scrollbars -->
    <SolidColorBrush x:Key="TrackBrush"            Color="#FFA8A8A8"/>
    <SolidColorBrush x:Key="ThumbKnobFill"         Color="#FF0067C0"/>
    <SolidColorBrush x:Key="ThumbKnobStroke"       Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ToggleOffBrush"        Color="#FFF6F6F6"/>
    <SolidColorBrush x:Key="ToggleKnobOffBrush"    Color="#FF5F5F5F"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#FFC2C2C2"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FFA6A6A6"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush"  Color="#FF8A8A8A"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonBg"        Color="#FFFDFDFD"/>
    <SolidColorBrush x:Key="ButtonHoverBg"   Color="#FFF6F6F6"/>
    <SolidColorBrush x:Key="ButtonPressedBg" Color="#FFF0F0F0"/>

    <!-- Misc -->
    <SolidColorBrush x:Key="SelectionBrush"      Color="#FF0067C0"/>
    <SolidColorBrush x:Key="RowHoverBrush"       Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="ComboArrowBrush"     Color="#FF5F5F5F"/>
    <SolidColorBrush x:Key="HoverOverlayBrush"   Color="#0A000000"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#06000000"/>
    <SolidColorBrush x:Key="TabHoverTextBrush"   Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="InfoGlyphBrush"      Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="CaptionHoverBrush"   Color="#0F000000"/>
    <Color x:Key="ShadowColor">#FF000000</Color>

</ResourceDictionary>
