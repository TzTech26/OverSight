<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════ Dark palette ════════════════ -->
    <!-- Keys here MUST match Light.xaml one-for-one; ThemeManager swaps the whole
         dictionary at runtime and every brush is referenced via DynamicResource. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgBrush"          Color="#FF111111"/>
    <SolidColorBrush x:Key="ChromeBrush"      Color="#FF0D0D0D"/>
    <SolidColorBrush x:Key="TabBarBrush"      Color="#FF161616"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"  Color="#FF1E1E1E"/>

    <!-- Strokes / dividers -->
    <SolidColorBrush x:Key="StrokeBrush"           Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="DividerBrush"          Color="#FF262626"/>
    <SolidColorBrush x:Key="StrokeStrongBrush"     Color="#FF484848"/>
    <SolidColorBrush x:Key="ControlBorderBrush"    Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#FF606060"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush"       Color="#FF0078D4"/>
    <SolidColorBrush x:Key="AccentHoverBrush"  Color="#FF1987E0"/>
    <SolidColorBrush x:Key="AccentTextBrush"   Color="#FF4CC2FF"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#FF0067B8"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"       Color="#FFE4E4E4"/>
    <SolidColorBrush x:Key="TextMutedBrush"  Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="TextLabelBrush"  Color="#FFC2C2C2"/>
    <SolidColorBrush x:Key="TitleTextBrush"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="OnAccentBrush"   Color="#FFFFFFFF"/>

    <!-- Sliders / scrollbars -->
    <SolidColorBrush x:Key="TrackBrush"            Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="ThumbKnobFill"         Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="ThumbKnobStroke"       Color="#FF6A6A6A"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF555555"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush"  Color="#FF6A6A6A"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonBg"        Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="ButtonHoverBg"   Color="#FF3C3C3C"/>
    <SolidColorBrush x:Key="ButtonPressedBg" Color="#FF1E1E1E"/>

    <!-- Misc -->
    <SolidColorBrush x:Key="SelectionBrush"    Color="#FF2A82DA"/>
    <SolidColorBrush x:Key="RowHoverBrush"     Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="ComboArrowBrush"   Color="#FFBBBBBB"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="TabHoverTextBrush" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="InfoGlyphBrush"    Color="#FFCCCCCC"/>

</ResourceDictionary>
