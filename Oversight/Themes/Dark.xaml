<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════ Dark palette — Windows 11 native ════════════════ -->
    <!-- Neutral greys + Windows blue, matched to the built-in Settings app.
         Keys here MUST match Light.xaml one-for-one; ThemeManager swaps the whole
         dictionary at runtime and every brush is referenced via DynamicResource.
         Control templates live in Themes/Controls.xaml and only reference these keys. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="ChromeBrush"      Color="#FF1C1C1C"/>   <!-- sidebar / window chrome -->
    <SolidColorBrush x:Key="BgBrush"          Color="#FF202020"/>   <!-- page background -->
    <SolidColorBrush x:Key="TabBarBrush"      Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#FF2B2B2B"/>   <!-- cards -->
    <SolidColorBrush x:Key="SurfaceAltBrush"  Color="#FF323232"/>   <!-- inputs -->
    <SolidColorBrush x:Key="RaisedBrush"      Color="#FF2C2C2C"/>   <!-- popups, keycaps -->
    <SolidColorBrush x:Key="KeycapEdgeBrush"  Color="#FF161616"/>

    <!-- Strokes / dividers -->
    <SolidColorBrush x:Key="StrokeBrush"           Color="#FF1D1D1D"/>
    <SolidColorBrush x:Key="DividerBrush"          Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="StrokeStrongBrush"     Color="#FF3D3D3D"/>
    <SolidColorBrush x:Key="ControlBorderBrush"    Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#FF5C5C5C"/>

    <!-- Accent (Windows blue) -->
    <SolidColorBrush x:Key="AccentBrush"           Color="#FF4CC2FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="#FF47B1E8"/>
    <SolidColorBrush x:Key="AccentTextBrush"       Color="#FF60CDFF"/>
    <SolidColorBrush x:Key="AccentBorderBrush"     Color="#FF42A1D2"/>
    <SolidColorBrush x:Key="AccentSoftBrush"       Color="#0FFFFFFF"/>   <!-- neutral highlight, as in Win11 -->
    <SolidColorBrush x:Key="AccentSoftStrongBrush" Color="#1AFFFFFF"/>
    <Color x:Key="AccentGlowColor">#004CC2FF</Color>                     <!-- no glow: Win11 is flat -->
    <SolidColorBrush x:Key="AccentGradientBrush"      Color="#FF4CC2FF"/>
    <SolidColorBrush x:Key="AccentGradientHoverBrush" Color="#FF47B1E8"/>
    <SolidColorBrush x:Key="SidebarGlowBrush"         Color="Transparent"/>

    <!-- Status -->
    <SolidColorBrush x:Key="HotBrush"        Color="#FFFCE100"/>   <!-- caution: unsaved -->
    <SolidColorBrush x:Key="HotSoftBrush"    Color="#1FFCE100"/>
    <SolidColorBrush x:Key="HotTextBrush"    Color="#FFFCE100"/>
    <SolidColorBrush x:Key="DangerBrush"     Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#2EC42B1C"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFFF99A4"/>
    <SolidColorBrush x:Key="SuccessBrush"    Color="#FF6CCB5F"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"       Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextMutedBrush"  Color="#FFC5C5C5"/>
    <SolidColorBrush x:Key="TextLabelBrush"  Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="TextFaintBrush"  Color="#FF787878"/>
    <SolidColorBrush x:Key="TitleTextBrush"  Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="OnAccentBrush"   Color="#FF000000"/>

    <!-- Sliders / toggles / scrollbars -->
    <SolidColorBrush x:Key="TrackBrush"            Color="#FF6E6E6E"/>
    <SolidColorBrush x:Key="ThumbKnobFill"         Color="#FF4CC2FF"/>   <!-- accent centre -->
    <SolidColorBrush x:Key="ThumbKnobStroke"       Color="#FF454545"/>   <!-- dark ring -->
    <SolidColorBrush x:Key="ToggleOffBrush"        Color="#14000000"/>
    <SolidColorBrush x:Key="ToggleKnobOffBrush"    Color="#FFCECECE"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF7A7A7A"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush"  Color="#FF8A8A8A"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonBg"        Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="ButtonHoverBg"   Color="#FF323232"/>
    <SolidColorBrush x:Key="ButtonPressedBg" Color="#FF272727"/>

    <!-- Misc -->
    <SolidColorBrush x:Key="SelectionBrush"      Color="#FF0078D4"/>
    <SolidColorBrush x:Key="RowHoverBrush"       Color="#FF323232"/>
    <SolidColorBrush x:Key="ComboArrowBrush"     Color="#FFC5C5C5"/>
    <SolidColorBrush x:Key="HoverOverlayBrush"   Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="TabHoverTextBrush"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="InfoGlyphBrush"      Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="CaptionHoverBrush"   Color="#14FFFFFF"/>
    <Color x:Key="ShadowColor">#FF000000</Color>

</ResourceDictionary>
