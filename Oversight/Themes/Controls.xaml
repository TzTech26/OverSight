<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Oversight.UI">

    <!--
        Shared control library for every Oversight window.
        Colours come from the swappable palette (Themes/Dark.xaml / Light.xaml) and are always
        referenced via DynamicResource so the UI re-themes live with Windows light/dark mode.
        Variants (accent / ghost / danger buttons, icons, empty states) are driven by the
        attached properties in UI/UiProps.cs so one template serves them all.
    -->

    <!-- ════════════════ Typography & icon fonts ════════════════ -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <ui:FirstLetterConverter x:Key="FirstLetter"/>

    <!-- ════════════════ Icons (24×24 stroke geometry) ════════════════ -->
    <GeometryGroup x:Key="IconZoom">
        <EllipseGeometry Center="10.5,10.5" RadiusX="7" RadiusY="7"/>
        <LineGeometry StartPoint="15.6,15.6" EndPoint="21,21"/>
        <LineGeometry StartPoint="10.5,7.5"  EndPoint="10.5,13.5"/>
        <LineGeometry StartPoint="7.5,10.5"  EndPoint="13.5,10.5"/>
    </GeometryGroup>

    <GeometryGroup x:Key="IconCrosshair">
        <EllipseGeometry Center="12,12" RadiusX="7.5" RadiusY="7.5"/>
        <LineGeometry StartPoint="12,1.5"  EndPoint="12,6.5"/>
        <LineGeometry StartPoint="12,17.5" EndPoint="12,22.5"/>
        <LineGeometry StartPoint="1.5,12"  EndPoint="6.5,12"/>
        <LineGeometry StartPoint="17.5,12" EndPoint="22.5,12"/>
        <EllipseGeometry Center="12,12" RadiusX="0.6" RadiusY="0.6"/>
    </GeometryGroup>

    <GeometryGroup x:Key="IconClicker">
        <PathGeometry Figures="M10,10 L20.5,14.2 L15.8,15.8 L14.2,20.5 Z"/>
        <LineGeometry StartPoint="10,2.5"   EndPoint="10,5.5"/>
        <LineGeometry StartPoint="2.5,10"   EndPoint="5.5,10"/>
        <LineGeometry StartPoint="4.7,4.7"  EndPoint="6.8,6.8"/>
        <LineGeometry StartPoint="15.3,4.7" EndPoint="13.2,6.8"/>
        <LineGeometry StartPoint="4.7,15.3" EndPoint="6.8,13.2"/>
    </GeometryGroup>

    <GeometryGroup x:Key="IconGamepad">
        <PathGeometry Figures="M7,7 H17 A5,5 0 0 1 22,12 V14.5 A3,3 0 0 1 16.9,16.6 L15.3,15 H8.7 L7.1,16.6 A3,3 0 0 1 2,14.5 V12 A5,5 0 0 1 7,7 Z"/>
        <LineGeometry StartPoint="7,9.8"  EndPoint="7,13.2"/>
        <LineGeometry StartPoint="5.3,11.5" EndPoint="8.7,11.5"/>
        <EllipseGeometry Center="16,10.8" RadiusX="0.5" RadiusY="0.5"/>
        <EllipseGeometry Center="18,12.8" RadiusX="0.5" RadiusY="0.5"/>
    </GeometryGroup>

    <GeometryGroup x:Key="IconSliders">
        <LineGeometry StartPoint="3.5,7"  EndPoint="11,7"/>
        <LineGeometry StartPoint="15,7"   EndPoint="20.5,7"/>
        <LineGeometry StartPoint="3.5,17" EndPoint="7,17"/>
        <LineGeometry StartPoint="11,17"  EndPoint="20.5,17"/>
        <EllipseGeometry Center="13,7" RadiusX="2" RadiusY="2"/>
        <EllipseGeometry Center="9,17" RadiusX="2" RadiusY="2"/>
    </GeometryGroup>

    <!-- The Oversight mark: a scope reticle on a Windows-blue tile (vector, so it stays crisp at any DPI). -->
    <DataTemplate x:Key="LogoMark">
        <Viewbox>
            <Grid Width="64" Height="64">
                <Border CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF60CDFF" Offset="0"/>
                            <GradientStop Color="#FF0078D4" Offset="0.55"/>
                            <GradientStop Color="#FF005A9E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Path Stroke="White" StrokeThickness="4.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Data>
                        <GeometryGroup>
                            <EllipseGeometry Center="32,32" RadiusX="15" RadiusY="15"/>
                            <LineGeometry StartPoint="32,9"  EndPoint="32,19"/>
                            <LineGeometry StartPoint="32,45" EndPoint="32,55"/>
                            <LineGeometry StartPoint="9,32"  EndPoint="19,32"/>
                            <LineGeometry StartPoint="45,32" EndPoint="55,32"/>
                        </GeometryGroup>
                    </Path.Data>
                </Path>
                <Ellipse Width="7" Height="7" Fill="White"/>
            </Grid>
        </Viewbox>
    </DataTemplate>

    <!-- ════════════════ Focus ring (keyboard only) ════════════════ -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="7" RadiusY="7" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════ Text styles ════════════════ -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize"   Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize"     Value="13.5"/>
        <Setter Property="Foreground"   Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin"       Value="0,4,0,0"/>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize"   Value="14.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}"/>
        <Setter Property="Margin"     Value="2,22,0,10"/>
    </Style>

    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize"   Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontSize"     Value="14"/>
        <Setter Property="FontWeight"   Value="Medium"/>
        <Setter Property="Foreground"   Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="RowDesc" TargetType="TextBlock">
        <Setter Property="FontSize"     Value="12.5"/>
        <Setter Property="Foreground"   Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight"   Value="18"/>
        <Setter Property="Margin"       Value="0,3,0,0"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource RowDesc}">
        <Setter Property="Margin" Value="2,0,0,0"/>
    </Style>

    <!-- Numeric read-out beside a slider (lives inside a ValuePill). -->
    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontFamily"          Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="FontSize"            Value="13"/>
        <Setter Property="Foreground"          Value="{DynamicResource AccentTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
    </Style>

    <Style x:Key="ValuePill" TargetType="Border">
        <Setter Property="Background"        Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="CornerRadius"      Value="4"/>
        <Setter Property="Padding"           Value="8,4"/>
        <Setter Property="MinWidth"          Value="70"/>
        <Setter Property="Margin"            Value="14,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ════════════════ Layout helpers ════════════════ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="8"/>
        <Setter Property="Padding"         Value="20,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="SettingRow" TargetType="Grid">
        <Setter Property="MinHeight" Value="62"/>
        <Setter Property="Margin"    Value="0,12"/>
    </Style>

    <Style x:Key="RowDivider" TargetType="Border">
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="Margin"     Value="0"/>
    </Style>

    <!-- "Unsaved changes" pill shown on a slot bar while the open slot has edits. -->
    <Style x:Key="UnsavedPill" TargetType="Border">
        <Setter Property="Background"        Value="{DynamicResource HotSoftBrush}"/>
        <Setter Property="BorderBrush"       Value="{DynamicResource HotBrush}"/>
        <Setter Property="BorderThickness"   Value="1"/>
        <Setter Property="CornerRadius"      Value="10"/>
        <Setter Property="Padding"           Value="9,2,10,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Visibility"        Value="Collapsed"/>
    </Style>

    <!-- Small neutral badge (e.g. "Soon"). -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background"        Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="CornerRadius"      Value="6"/>
        <Setter Property="Padding"           Value="6,1,6,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ════════════════ Buttons ════════════════ -->
    <!-- One template for every variant; colours come from UiProps attached properties. -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="5"
                Padding="{TemplateBinding Padding}"
                TextElement.Foreground="{TemplateBinding Foreground}"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center">
                <TextBlock x:Name="Ico"
                           Text="{Binding (ui:UiProps.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="{StaticResource IconFont}" FontSize="13"
                           VerticalAlignment="Center" Margin="0,1,8,0"/>
                <ContentPresenter x:Name="CP" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="ui:UiProps.Glyph" Value="{x:Null}">
                <Setter TargetName="Ico" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Ico" Property="Margin" Value="0"/>
                <Setter TargetName="CP"  Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{Binding (ui:UiProps.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter TargetName="Bd" Property="BorderBrush"
                        Value="{Binding (ui:UiProps.HoverBorderBrush), RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter TargetName="Bd" Property="TextElement.Foreground"
                        Value="{Binding (ui:UiProps.HoverForeground), RelativeSource={RelativeSource TemplatedParent}}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver"    Value="True"/>
                    <Condition Property="ui:UiProps.Glow" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55"
                                          Color="{DynamicResource AccentGlowColor}"/>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{Binding (ui:UiProps.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Default / secondary button -->
    <Style TargetType="Button">
        <Setter Property="Template"          Value="{StaticResource ButtonTemplate}"/>
        <Setter Property="FocusVisualStyle"  Value="{StaticResource FocusRing}"/>
        <Setter Property="Background"        Value="{DynamicResource ButtonBg}"/>
        <Setter Property="Foreground"        Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush"       Value="{DynamicResource StrokeStrongBrush}"/>
        <Setter Property="BorderThickness"   Value="1"/>
        <Setter Property="Padding"           Value="14,7"/>
        <Setter Property="MinHeight"         Value="34"/>
        <Setter Property="FontWeight"        Value="Medium"/>
        <Setter Property="Cursor"            Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="ui:UiProps.HoverBackground"   Value="{DynamicResource ButtonHoverBg}"/>
        <Setter Property="ui:UiProps.HoverBorderBrush"  Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="ui:UiProps.HoverForeground"   Value="{DynamicResource TitleTextBrush}"/>
        <Setter Property="ui:UiProps.PressedBackground" Value="{DynamicResource ButtonPressedBg}"/>
    </Style>

    <!-- Primary action -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"  Value="{DynamicResource AccentGradientBrush}"/>
        <Setter Property="Foreground"  Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="ui:UiProps.HoverBackground"   Value="{DynamicResource AccentGradientHoverBrush}"/>
        <Setter Property="ui:UiProps.HoverBorderBrush"  Value="{DynamicResource AccentHoverBrush}"/>
        <Setter Property="ui:UiProps.HoverForeground"   Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="ui:UiProps.PressedBackground" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="ui:UiProps.Glow"              Value="True"/>
    </Style>

    <!-- Low-emphasis action -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground"  Value="{DynamicResource TextLabelBrush}"/>
        <Setter Property="ui:UiProps.HoverBackground"   Value="{DynamicResource HoverOverlayBrush}"/>
        <Setter Property="ui:UiProps.HoverBorderBrush"  Value="Transparent"/>
        <Setter Property="ui:UiProps.HoverForeground"   Value="{DynamicResource TitleTextBrush}"/>
        <Setter Property="ui:UiProps.PressedBackground" Value="{DynamicResource PressedOverlayBrush}"/>
    </Style>

    <!-- Destructive action -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground"  Value="{DynamicResource DangerTextBrush}"/>
        <Setter Property="ui:UiProps.HoverBackground"   Value="{DynamicResource DangerSoftBrush}"/>
        <Setter Property="ui:UiProps.HoverBorderBrush"  Value="{DynamicResource DangerBrush}"/>
        <Setter Property="ui:UiProps.HoverForeground"   Value="{DynamicResource DangerTextBrush}"/>
        <Setter Property="ui:UiProps.PressedBackground" Value="{DynamicResource DangerSoftBrush}"/>
    </Style>

    <!-- ════════════════ Toggle switch (all CheckBoxes) ════════════════ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground"               Value="{DynamicResource TextBrush}"/>
        <Setter Property="FocusVisualStyle"         Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor"                   Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="42" Height="22" CornerRadius="11"
                                Background="{DynamicResource ToggleOffBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1.5"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="{DynamicResource ToggleKnobOffBrush}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobX" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ContentPresenter x:Name="CP" Grid.Column="1" Margin="12,0,0,0"
                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="CP" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"  Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Knob"  Property="Fill"        Value="{DynamicResource OnAccentBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X"
                                                         To="20" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked"   Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource InputBorderHoverBrush}"/>
                            <Setter TargetName="Knob"  Property="Fill"        Value="{DynamicResource TextLabelBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked"   Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background"  Value="{DynamicResource AccentHoverBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width"  Value="14"/>
                            <Setter TargetName="Knob" Property="Height" Value="14"/>
                            <Setter TargetName="Knob" Property="Margin" Value="3,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════ Slider ════════════════ -->
    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width"  Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse x:Name="Knob" Fill="{DynamicResource ThumbKnobFill}"
                                 Stroke="{DynamicResource ThumbKnobStroke}" StrokeThickness="4.5"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="StrokeThickness" Value="3"/>
                            <Setter TargetName="Knob" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.7"
                                                      Color="{DynamicResource AccentGlowColor}"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="StrokeThickness" Value="5"/>
                            <Setter TargetName="Knob" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.85"
                                                      Color="{DynamicResource AccentGlowColor}"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderFillButtonStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource AccentGradientBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderTrackButtonStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" Height="18"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle"     Value="{StaticResource FocusRing}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="MinHeight"            Value="24"/>
        <Setter Property="SnapsToDevicePixels"  Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource TrackBrush}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillButtonStyle}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackButtonStyle}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════ ScrollBar (slim) ════════════════ -->
    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="4" Margin="2" Background="{DynamicResource ScrollThumbBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbDragBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width"      Value="10"/>
        <Setter Property="MinWidth"   Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width"     Value="Auto"/>
                <Setter Property="MinWidth"  Value="0"/>
                <Setter Property="Height"    Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ════════════════ Labels / ToolTips ════════════════ -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource TextLabelBrush}"/>
        <Setter Property="Padding"    Value="0,2"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="6,4,6,10" Padding="11,8" CornerRadius="8" MaxWidth="320"
                            Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35"
                                              Color="{DynamicResource ShadowColor}"/>
                        </Border.Effect>
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════ TextBox ════════════════ -->
    <Style TargetType="TextBox">
        <Setter Property="Background"        Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="Foreground"        Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush"       Value="{DynamicResource StrokeStrongBrush}"/>
        <Setter Property="BorderThickness"   Value="1"/>
        <Setter Property="Padding"           Value="10,0"/>
        <Setter Property="MinHeight"         Value="34"/>
        <Setter Property="CaretBrush"        Value="{DynamicResource AccentTextBrush}"/>
        <Setter Property="SelectionBrush"    Value="{DynamicResource AccentBrush}"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <!-- Windows 11-style accent underline while focused -->
                        <Border x:Name="Underline" Height="2" CornerRadius="1" Margin="7,0,7,0"
                                VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}"
                                Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd"        Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Underline" Property="Visibility"  Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════ Hotkey capture box (keycap) ════════════════ -->
    <Style TargetType="ui:HotkeyCaptureBox">
        <Setter Property="Background"        Value="{DynamicResource RaisedBrush}"/>
        <Setter Property="Foreground"        Value="{DynamicResource TitleTextBrush}"/>
        <Setter Property="BorderBrush"       Value="{DynamicResource StrokeStrongBrush}"/>
        <Setter Property="BorderThickness"   Value="1"/>
        <Setter Property="Width"             Value="200"/>
        <Setter Property="Height"            Value="38"/>
        <Setter Property="FontFamily"        Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontWeight"        Value="SemiBold"/>
        <Setter Property="FontSize"          Value="13.5"/>
        <Setter Property="TextAlignment"     Value="Center"/>
        <Setter Property="Cursor"            Value="Hand"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:HotkeyCaptureBox">
                    <Grid>
                        <!-- keycap edge -->
                        <Border CornerRadius="6" Margin="0,3,0,0" Background="{DynamicResource KeycapEdgeBrush}"/>
                        <Border x:Name="Bd" CornerRadius="6" Margin="0,0,0,3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <TextBlock x:Name="Kb" Text="&#xE765;" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" Margin="11,0,0,0" FontWeight="Normal"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="26,0,10,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="(none)">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderHoverBrush}"/>
                        </Trigger>
                        <!-- Focused = listening for a key -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource AccentSoftStrongBrush}"/>
                            <Setter TargetName="Kb" Property="Foreground"  Value="{DynamicResource AccentTextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.6"
                                                      Color="{DynamicResource AccentGlowColor}"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════ ComboBox ════════════════ -->
    <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
        <Border Background="Transparent"/>
    </ControlTemplate>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding"    Value="10,7"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="0,1">
                        <Grid>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" Margin="2,0,0,0"
                                    HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                                    Visibility="Hidden"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground"          Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background"          Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource StrokeStrongBrush}"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="Height"              Value="36"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="MaxDropDownHeight"   Value="320"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      Template="{StaticResource ComboToggleTemplate}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="12,0,34,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                   FontSize="10" Margin="0,0,13,0" IsHitTestVisible="False"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5"
                                   Foreground="{DynamicResource ComboArrowBrush}">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="ChevronRotate" Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade" VerticalOffset="2" HorizontalOffset="-8"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Margin="8,4,8,14" Padding="4" CornerRadius="8"
                                    Background="{DynamicResource RaisedBrush}"
                                    BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4"
                                                      Color="{DynamicResource ShadowColor}"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd"      Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Chevron" Property="Foreground"  Value="{DynamicResource AccentTextBrush}"/>
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════ ListBox (with empty state) ════════════════ -->
    <Style TargetType="ListBox">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                            <StackPanel x:Name="Empty" Visibility="Collapsed" Margin="24"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="28"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}"/>
                                <TextBlock Text="{Binding (ui:UiProps.EmptyText), RelativeSource={RelativeSource TemplatedParent}}"
                                           Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
                                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasItems" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Empty" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="ui:UiProps.EmptyText" Value="{x:Null}">
                            <Setter TargetName="Empty" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding"    Value="12,8"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="0,1"
                            BorderBrush="Transparent" BorderThickness="1">
                        <Grid>
                            <Border x:Name="Bar" Width="3" Height="20" CornerRadius="1.5" Margin="2,0,0,0"
                                    HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                                    Visibility="Hidden"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd"  Property="Background"  Value="{DynamicResource AccentSoftBrush}"/>
                            <Setter TargetName="Bd"  Property="BorderBrush" Value="{DynamicResource AccentSoftStrongBrush}"/>
                            <Setter TargetName="Bar" Property="Visibility"  Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════ Dialog window chrome ════════════════ -->
    <Style x:Key="DialogWindow" TargetType="Window">
        <Setter Property="Background"   Value="{DynamicResource BgBrush}"/>
        <Setter Property="Foreground"   Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily"   Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize"     Value="13.5"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

</ResourceDictionary>
